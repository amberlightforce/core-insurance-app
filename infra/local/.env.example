# Copy to infra/local/.env (git-ignored) and set the passwords. Synthetic data only.
# Variable names follow INFRASTRUCTURE §5; ASP.NET Core maps "__" to ":".

# --- PostgreSQL (used by compose for the postgres container and pg-init) ---
PG_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-app
MIGRATOR_DB_PASSWORD=change-me-migrator

# --- Application ---
ASPNETCORE_ENVIRONMENT=Development
# api and worker connect as the `app` role; the migrate job as `migrator`. Repeat the passwords set above.
ConnectionStrings__Core=Host=postgres;Database=coreins;Username=app;Password=change-me-app
ConnectionStrings__Migrator=Host=postgres;Database=coreins;Username=migrator;Password=change-me-migrator

# Blob storage: Azurite's well-known development account.
Blob__ServiceUri=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
Blob__UseManagedIdentity=false

# Entra ID dev tenant app registration (redirect URI http://localhost:5000/signin-oidc).
AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000

DocRender__Url=http://gotenberg:3000
Email__Provider=Smtp
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025

# Traces, metrics and logs to the Aspire Dashboard (UI on http://localhost:18888).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:18889

Ai__Enabled=false
Stamp__Id=local
Stamp__LegalEntity=GR-TEST
Stamp__Country=GR
# UUID of the stamp's legal entity (rows and encryption keys; the MKT registry replaces it in W1-MKT). Synthetic.

# Development-only local sign-in (D-SLC-03). Honoured only with ASPNETCORE_ENVIRONMENT=Development; in any other
# environment the Host refuses to start while this is true. Users and roles: src/CoreIns.Host/appsettings.Development.json.
DevAuthentication__Enabled=true

# Field-level encryption, local key provider (Development only): 32 bytes, base64. This value is an obvious synthetic
# placeholder ("coreins-local-dev-only-not-a-key"); generate your own with openssl rand -base64 32. Changing it makes
# data encrypted before unreadable (docker compose down -v to start over). Production uses Key Vault.
DataProtection__LocalMasterKey=Y29yZWlucy1sb2NhbC1kZXYtb25seS1ub3QtYS1rZXk=

# Greece pack default region for national phone numbers (REQ-PTY-082).
Party__DefaultCallingCode=30

# Host ports (all bound to 127.0.0.1). Uncomment and change any that clash with other containers on your machine.
# PG_HOST_PORT=5432
# API_HOST_PORT=5000
# AZURITE_HOST_PORT=10000
# GOTENBERG_HOST_PORT=3000
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# WIREMOCK_HOST_PORT=8089
# OTEL_UI_HOST_PORT=18888
# OTEL_HOST_PORT=4317
