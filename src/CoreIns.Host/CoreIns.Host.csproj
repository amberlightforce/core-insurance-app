<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The single deployable. APP_ROLE selects the mode (INFRASTRUCTURE §1):
      api     - REST APIs + OpenAPI, the built React app as static files, Hangfire dashboard (admin policy)
      worker  - Hangfire server (jobs, deadlines, outbox dispatch, integrations); health endpoints only
      migrate - creates schemas and installs Hangfire storage, then exits (never on application start-up)
  -->
  <PropertyGroup>
    <RootNamespace>CoreIns.Host</RootNamespace>
    <AssemblyName>CoreIns.Host</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one bootstrap script shared with infra/local/pg-init and the integration tests. -->
    <EmbeddedResource Include="..\..\infra\database\bootstrap.sql" LogicalName="CoreIns.Host.Database.bootstrap.sql" Link="Database\bootstrap.sql" />
    <!-- Greek search objects (F-1e), applied by the bootstrap after bootstrap.sql: they live in schema public, which only the administrator may change. -->
    <EmbeddedResource Include="..\..\infra\database\greek-search.sql" LogicalName="CoreIns.Host.Database.greek-search.sql" Link="Database\greek-search.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-PRG-21: one permission/authority file per module and the Development sign-in users; read at start-up from the content root (build output, publish output, container image). -->
    <Content Update="permissions\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="dev-users.*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreIns.Host.Tests" />
    <InternalsVisibleTo Include="CoreIns.IntegrationTests" />
    <InternalsVisibleTo Include="CoreIns.ArchitectureTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreIns.SharedKernel\CoreIns.SharedKernel.csproj" />
    <ProjectReference Include="..\CoreIns.Platform\CoreIns.Platform.csproj" />
    <ProjectReference Include="..\CoreIns.CountryPacks.GR\CoreIns.CountryPacks.GR.csproj" />
    <ProjectReference Include="..\CoreIns.CountryPacks.CY\CoreIns.CountryPacks.CY.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Party\CoreIns.Modules.Party.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Product\CoreIns.Modules.Product.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Rating\CoreIns.Modules.Rating.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Underwriting\CoreIns.Modules.Underwriting.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Policy\CoreIns.Modules.Policy.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Billing\CoreIns.Modules.Billing.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Claims\CoreIns.Modules.Claims.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Reinsurance\CoreIns.Modules.Reinsurance.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Finance\CoreIns.Modules.Finance.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Documents\CoreIns.Modules.Documents.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Compliance\CoreIns.Modules.Compliance.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Channels\CoreIns.Modules.Channels.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Work\CoreIns.Modules.Work.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Data\CoreIns.Modules.Data.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Migration\CoreIns.Modules.Migration.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Market\CoreIns.Modules.Market.csproj" />
  </ItemGroup>

</Project>
