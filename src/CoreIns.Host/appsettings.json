{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Authorization": {
    "AdminRole": "Platform.Admin"
  },
  "Database": {
    "AppRole": "app"
  },
  "Platform": {
    "Numbering": {
      // Prefixes are technical defaults, not pack values: the PRDs give no Greek formats (D-SLC-08).
      "Schemes": {
        "PARTY": { "Prefix": "P", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "ACCOUNT": { "Prefix": "A", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "PRODUCER_CODE": { "Prefix": "PC", "Width": 6, "GapPolicy": "Gapless" },
        "JOB": { "Prefix": "Q", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 50 },
        "POLICY": { "Prefix": "POL", "Width": 9, "GapPolicy": "Gapless" },
        "INVOICE": { "Prefix": "INV", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "RECEIPT": { "Prefix": "RCP", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "CLAIM": { "Prefix": "CLM", "Width": 9, "GapPolicy": "Gapless" },
        "JOURNAL": { "Prefix": "JNL", "Width": 10, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "BILLING_ACCOUNT": { "Prefix": "BA", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "DISBURSEMENT": { "Prefix": "DSB", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 }
      }
    },
    "Authority": {
      // ILLUSTRATIVE TEST DATA (D-SL2-03; PRD-07 §16.5 item 3 is open): claims authority per financial transaction, EUR.
      // Never presented as approved limits; "Illustrative": true grants are ignored in Production (fail closed: DENY).
      // The exact limit is allowed; one cent above refers to the next role (four eyes); above the manager's limit, DENY.
      "Grants": [
        {
          "Id": "clm-handler-reserve-illustrative", "Role": "Staff.ClaimsHandler", "Type": "CLM.RESERVE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "clm-handler-payment-illustrative", "Role": "Staff.ClaimsHandler", "Type": "CLM.PAYMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "clm-manager-reserve-illustrative", "Role": "Staff.ClaimsManager", "Type": "CLM.RESERVE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "50000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "clm-manager-payment-illustrative", "Role": "Staff.ClaimsManager", "Type": "CLM.PAYMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "50000.00", "Currency": "EUR" } ]
        },
        // ILLUSTRATIVE TEST DATA (PRD-04 §12.2 UW.ISSUE_APPROVAL; no approved underwriting authority matrix exists yet): the
        // underwriting manager may decide the referrals of the illustrative motor rule set UW-MOTOR-GR-B. Dropped in Production.
        {
          "Id": "uw-manager-issue-approval-illustrative", "Role": "Staff.UnderwritingManager", "Type": "UW.ISSUE_APPROVAL", "Illustrative": true,
          "Limits": [ { "Dimension": "issueType", "Comparison": "InSet", "Codes": [ "DRIVER_AGE_REFERRAL", "VEHICLE_AGE_REFERRAL", "VEHICLE_VALUE_REFERRAL" ] } ]
        }
      ]
    },
    "Permissions": {
      "Grants": {
        "pty.Party.create": [ "Staff.Underwriter", "Staff.Billing" ],
        "pty.Party.get": [ "Staff.Underwriter", "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "pty.Party.search": [ "Staff.Underwriter", "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "pty.Screening.screen": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "pty.Party.revealP2": [ "Staff.Underwriter" ],
        "pty.Intermediary.create": [ "Staff.Underwriter", "Platform.Admin" ],
        "pty.Intermediary.update": [ "Staff.Underwriter", "Platform.Admin" ],
        "pty.ProducerCode.validate": [ "Staff.Underwriter", "Staff.Billing" ],
        "pty.ProducerCode.search": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "rat.Rate.rate": [ "Staff.Underwriter", "Staff.Billing" ],
        "rat.Worksheet.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "rat.RatingArtifact.resolve": [ "Staff.Underwriter", "Staff.Billing" ],
        "uw.Rules.evaluate": [ "Staff.Underwriter" ],
        "uw.Issue.blockingStatus": [ "Staff.Underwriter", "Staff.Billing" ],
        "uw.Issue.list": [ "Staff.Underwriter", "Staff.UnderwritingManager", "Platform.Admin" ],
        "uw.Issue.decide": [ "Staff.UnderwritingManager" ],
        "pfc.ProductVersion.resolve": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.ProductVersion.import": [ "Platform.Admin" ],
        "pfc.Artifact.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.Catalogue.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.Catalogue.getItem": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.ChargeType.list": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.QuestionSet.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.QuestionSet.evaluate": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Configuration.resolve": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Configuration.currentHash": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Rounding.apply": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Submission.create": [ "Staff.Underwriter" ],
        "pol.Job.updateDraft": [ "Staff.Underwriter" ],
        "pol.Job.quote": [ "Staff.Underwriter" ],
        "pol.Job.bind": [ "Staff.Underwriter" ],
        "pol.Job.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Policy.get": [ "Staff.Underwriter", "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "pol.Term.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Snapshot.get": [ "Staff.Underwriter", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "pol.Policy.search": [ "Staff.Underwriter", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.BillingAccount.get": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Invoice.get": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Invoice.list": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Payment.take": [ "Staff.Billing" ],
        "bil.Receipt.get": [ "Staff.Billing", "Platform.Admin" ],
        "bil.Allocation.allocate": [ "Staff.Billing" ],
        // SL2-BIL-DISB: Claims calls create/request in process; the API serves reads (claims roles: SL2-PLT).
        "bil.PayeeAccount.create": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "bil.PayeeAccount.get": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Disbursement.get": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "cmp.FiscalDocument.request": [ "Platform.Admin" ],
        "cmp.FiscalDocument.get": [ "Staff.Billing", "Platform.Admin" ],
        "fin.Journal.get": [ "Staff.Finance", "Staff.Billing", "Platform.Admin" ],
        "fin.Journal.query": [ "Staff.Finance", "Staff.Billing", "Platform.Admin" ],
        "fin.PostingRules.list": [ "Staff.Finance", "Platform.Admin" ],
        "plt.Approval.decide": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "plt.Approval.get": [ "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "plt.Approval.list": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Fnol.submit": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Fnol.get": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Fnol.validate": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Claim.get": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Claim.search": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Claim.close": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Exposure.create": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.TransactionSet.build": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.TransactionSet.submit": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.TransactionSet.get": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Financials.get": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.Payment.list": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.PayeeAccount.capture": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "clm.PayeeAccount.list": [ "Staff.ClaimsHandler", "Staff.ClaimsManager" ]
      }
    }
  },
  "Billing": {
    // Stamp settings, not regulatory values: the legal entity's zone (business and accounting dates) and the currency of
    // a new billing account when its term arrives before its charges (PolicyBound carries no currency).
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR",
    // bil.payee.cooling_off.<purpose>: PRD-06 §10.2 default 30 days for every purpose until MKT serves the key (BR-BIL-062).
    "PayeeCoolingOffDays": 30
  },
  "Finance": {
    // Stamp setting, not a regulatory value: the legal entity's zone (business date of a posting event without an
    // accounting date, REQ-FIN-035).
    "TimeZone": "Europe/Athens"
  },
  "Policy": {
    // Stamp settings, not regulatory values: the legal entity's zone (zone conversion only at the edge, REQ-POL-041),
    // the term currency when a submission names none, and pol.quote.validity_days (PRD-05 §10.2 default 30) until
    // MKT's configuration resolver serves it.
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR",
    "QuoteValidityDays": 30
  },
  "Claims": {
    // Stamp settings, not regulatory values: the legal entity's zone (loss and notice dates, D-SLC-13), the handling
    // segment until segmentation exists (REQ-CLM-083..088), the Solvency II LoB marker until the PFC mapping is wired
    // (REQ-PFC-005), and the duplicate window in days either side of the loss date (REQ-CLM-041; 0 = same date).
    "TimeZone": "Europe/Athens",
    "DefaultHandlingSegment": "STANDARD",
    "UnmappedSiiLob": "UNMAPPED",
    "DuplicateWindowDays": 0,
    "Financials": {
      // ILLUSTRATIVE TEST DATA (D-SL2-04; PRD-07 §16.5 item 1 is open): motor cost type → cost categories. Never presented
      // as approved values. AutoAdjustReserve is REQ-CLM-097's per-line switch (one value for every line in the slice).
      "Illustrative": true,
      "CostCategories": {
        "INDEMNITY": [ "VEHICLE_REPAIR", "TOTAL_LOSS" ],
        "EXPENSE_ALLOCATED": [ "ASSESSOR_FEE" ]
      },
      "AutoAdjustReserve": true
    }
  },
  "AllowedHosts": "*"
}
