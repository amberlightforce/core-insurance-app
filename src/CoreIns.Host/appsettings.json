{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Authorization": {
    "AdminRole": "Platform.Admin"
  },
  "Database": {
    "AppRole": "app"
  },
  "Platform": {
    "Numbering": {
      // Prefixes are technical defaults, not pack values: the PRDs give no Greek formats (D-SLC-08).
      "Schemes": {
        "PARTY": { "Prefix": "P", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "ACCOUNT": { "Prefix": "A", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "PRODUCER_CODE": { "Prefix": "PC", "Width": 6, "GapPolicy": "Gapless" },
        "JOB": { "Prefix": "Q", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 50 },
        "POLICY": { "Prefix": "POL", "Width": 9, "GapPolicy": "Gapless" },
        "INVOICE": { "Prefix": "INV", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "RECEIPT": { "Prefix": "RCP", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "CLAIM": { "Prefix": "CLM", "Width": 9, "GapPolicy": "Gapless" },
        "JOURNAL": { "Prefix": "JNL", "Width": 10, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "BILLING_ACCOUNT": { "Prefix": "BA", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 }
      }
    },
    "Permissions": {
      "Grants": {
        "pty.Party.create": [ "Staff.Underwriter", "Staff.Billing" ],
        "pty.Party.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pty.Party.search": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pty.Party.revealP2": [ "Staff.Underwriter" ],
        "pty.Intermediary.create": [ "Staff.Underwriter", "Platform.Admin" ],
        "pty.Intermediary.update": [ "Staff.Underwriter", "Platform.Admin" ],
        "pty.ProducerCode.validate": [ "Staff.Underwriter", "Staff.Billing" ],
        "pty.ProducerCode.search": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "rat.Rate.rate": [ "Staff.Underwriter", "Staff.Billing" ],
        "rat.Worksheet.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "rat.RatingArtifact.resolve": [ "Staff.Underwriter", "Staff.Billing" ],
        "uw.Rules.evaluate": [ "Staff.Underwriter" ],
        "uw.Issue.blockingStatus": [ "Staff.Underwriter", "Staff.Billing" ],
        "pfc.ProductVersion.resolve": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.ProductVersion.import": [ "Platform.Admin" ],
        "pfc.Artifact.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.Catalogue.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.Catalogue.getItem": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.ChargeType.list": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.QuestionSet.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pfc.QuestionSet.evaluate": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Configuration.resolve": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Configuration.currentHash": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "mkt.Rounding.apply": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Submission.create": [ "Staff.Underwriter" ],
        "pol.Job.updateDraft": [ "Staff.Underwriter" ],
        "pol.Job.quote": [ "Staff.Underwriter" ],
        "pol.Job.bind": [ "Staff.Underwriter" ],
        "pol.Job.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Policy.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "pol.Term.get": [ "Staff.Underwriter", "Staff.Billing", "Platform.Admin" ],
        "bil.BillingAccount.get": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Invoice.get": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Invoice.list": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Payment.take": [ "Staff.Billing" ],
        "bil.Receipt.get": [ "Staff.Billing", "Platform.Admin" ],
        "bil.Allocation.allocate": [ "Staff.Billing" ],
        "cmp.FiscalDocument.request": [ "Platform.Admin" ],
        "cmp.FiscalDocument.get": [ "Staff.Billing", "Platform.Admin" ]
      }
    }
  },
  "Billing": {
    // Stamp settings, not regulatory values: the legal entity's zone (business and accounting dates) and the currency of
    // a new billing account when its term arrives before its charges (PolicyBound carries no currency).
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR"
  },
  "Policy": {
    // Stamp settings, not regulatory values: the legal entity's zone (zone conversion only at the edge, REQ-POL-041),
    // the term currency when a submission names none, and pol.quote.validity_days (PRD-05 §10.2 default 30) until
    // MKT's configuration resolver serves it.
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR",
    "QuoteValidityDays": 30
  },
  "AllowedHosts": "*"
}
