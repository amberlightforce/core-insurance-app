{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" }
      }
    ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": ""
  },
  "Authorization": {
    "AdminRole": "Platform.Admin"
  },
  "Database": {
    "AppRole": "app"
  },
  "Platform": {
    "Numbering": {
      // Prefixes are technical defaults, not pack values: the PRDs give no Greek formats (D-SLC-08).
      "Schemes": {
        "PARTY": { "Prefix": "P", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "ACCOUNT": { "Prefix": "A", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "PRODUCER_CODE": { "Prefix": "PC", "Width": 6, "GapPolicy": "Gapless" },
        "JOB": { "Prefix": "Q", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 50 },
        "POLICY": { "Prefix": "POL", "Width": 9, "GapPolicy": "Gapless" },
        "INVOICE": { "Prefix": "INV", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "CREDIT_NOTE": { "Prefix": "CN", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "RECEIPT": { "Prefix": "RCP", "Width": 8, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "CLAIM": { "Prefix": "CLM", "Width": 9, "GapPolicy": "Gapless" },
        "JOURNAL": { "Prefix": "JNL", "Width": 10, "GapPolicy": "Gapless", "Reset": "Yearly" },
        "BILLING_ACCOUNT": { "Prefix": "BA", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "DISBURSEMENT": { "Prefix": "DSB", "Width": 9, "GapPolicy": "GapsAllowed", "BlockSize": 20 },
        "RI_CONTRACT": { "Prefix": "RIC", "Width": 6, "GapPolicy": "Gapless" }
      }
    }
  },
  "Billing": {
    // Stamp settings, not regulatory values: the legal entity's zone (business and accounting dates) and the currency of
    // a new billing account when its term arrives before its charges (PolicyBound carries no currency).
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR",
    // bil.payee.cooling_off.<purpose>: PRD-06 §10.2 default 30 days for every purpose until MKT serves the key (BR-BIL-062).
    "PayeeCoolingOffDays": 30
  },
  "Finance": {
    // Stamp setting, not a regulatory value: the legal entity's zone (business date of a posting event without an
    // accounting date, REQ-FIN-035).
    "TimeZone": "Europe/Athens"
  },
  "Policy": {
    // Stamp settings, not regulatory values: the legal entity's zone (zone conversion only at the edge, REQ-POL-041),
    // the term currency when a submission names none, and pol.quote.validity_days (PRD-05 §10.2 default 30) until
    // MKT's configuration resolver serves it.
    "TimeZone": "Europe/Athens",
    "DefaultCurrency": "EUR",
    "QuoteValidityDays": 30
  },
  "Claims": {
    // Stamp settings, not regulatory values: the legal entity's zone (loss and notice dates, D-SLC-13), the handling
    // segment until segmentation exists (REQ-CLM-083..088), the Solvency II LoB marker until the PFC mapping is wired
    // (REQ-PFC-005), and the duplicate window in days either side of the loss date (REQ-CLM-041; 0 = same date).
    "TimeZone": "Europe/Athens",
    "DefaultHandlingSegment": "STANDARD",
    "UnmappedSiiLob": "UNMAPPED",
    "DuplicateWindowDays": 0,
    "Financials": {
      // ILLUSTRATIVE TEST DATA (D-SL2-04; PRD-07 §16.5 item 1 is open): motor cost type → cost categories. Never presented
      // as approved values. AutoAdjustReserve is REQ-CLM-097's per-line switch (one value for every line in the slice).
      "Illustrative": true,
      "CostCategories": {
        "INDEMNITY": [ "VEHICLE_REPAIR", "TOTAL_LOSS" ],
        "EXPENSE_ALLOCATED": [ "ASSESSOR_FEE" ]
      },
      "AutoAdjustReserve": true
    }
  },
  "AllowedHosts": "*"
}
