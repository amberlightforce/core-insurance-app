{
  "Platform": {
    "Permissions": {
      "Grants": {
        "bil.Suspense.suggestMatch": [ "Staff.Billing", "Platform.Admin" ],
        "bil.BillingAccount.get": [ "Staff.Billing", "Staff.Underwriter", "Platform.Admin" ],
        // BO-BIL-01: account lifecycle. Reads for billing staff and underwriters; suspend/resume, close and reopen for billing staff and managers; the payer change is a manager decision.
        "bil.BillingAccount.search": [ "Staff.Billing", "Staff.BillingManager", "Staff.Underwriter", "Platform.Admin" ],
        "bil.BillingAccount.update": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.BillingAccount.close": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.BillingAccount.reopen": [ "Staff.BillingManager" ],
        "bil.BillingAccount.changePayer": [ "Staff.BillingManager" ],
        "bil.Invoice.get": [ "Staff.Billing", "Staff.BillingManager", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Invoice.list": [ "Staff.Billing", "Staff.BillingManager", "Staff.Underwriter", "Platform.Admin" ],
        "bil.Receivable.register": [ "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Receivable.get": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Receivable.list": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Payment.take": [ "Staff.Billing" ],
        "bil.Receipt.get": [ "Staff.Billing", "Platform.Admin" ],
        "bil.Allocation.allocate": [ "Staff.Billing" ],
        // BO-BIL-03: plan catalogue and preview are reads for billing staff; select/change write the plan instance.
        "bil.PaymentPlan.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.PaymentPlan.select": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.PaymentPlan.change": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.BillingPreview.compute": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        // BO-BIL-04: down-payment bind gate; staff who can bind (and the agent channel) see the status and initiate the payment.
        "bil.DownPayment.status": [ "Staff.Billing", "Staff.BillingManager", "Staff.Underwriter", "Platform.Admin" ],
        "bil.DownPayment.initiate": [ "Staff.Billing", "Staff.BillingManager", "Staff.Underwriter", "Platform.Admin" ],
        // BO-BIL-06a: payer instruments and SEPA mandates; reads for billing staff, writes for billing staff and managers.
        "bil.PaymentInstrument.add": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.PaymentInstrument.remove": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.PaymentInstrument.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Mandate.create": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Mandate.sign": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Mandate.amend": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Mandate.cancel": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Mandate.get": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        // BO-BIL-07: receipt list for billing staff; unallocate/reallocate need BIL.ALLOCATION_REVERSE authority over the amount (checked again by the handler).
        "bil.Receipt.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Allocation.unallocate": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Allocation.reallocate": [ "Staff.Billing", "Staff.BillingManager" ],
        // BO-BIL-13: write-offs are proposed by billing staff, decided by a billing manager (a second person with BIL.WRITE_OFF authority over the amount) and posted; money transfers between accounts of one payer.
        "bil.WriteOff.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.WriteOff.propose": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.WriteOff.decide": [ "Staff.BillingManager" ],
        "bil.WriteOff.post": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Transfer.money": [ "Staff.Billing", "Staff.BillingManager" ],
        // SL2-BIL-DISB: Claims calls create/request in process; the API serves reads (claims roles: SL2-PLT).
        "bil.PayeeAccount.create": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "bil.PayeeAccount.list": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        // BO-BIL-09: verification of payee runs a bank check; billing staff and claims roles that register accounts may re-run it.
        "bil.PayeeAccount.verify": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "bil.PayeeAccount.get": [ "Staff.Billing", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        // BO-BIL-09: the public facade for non-claim sources (commission, levy, tax remittance, other); BIL.DISBURSEMENT authority is checked again by the handler.
        "bil.Disbursement.request": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Disbursement.get": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Disbursement.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Disbursement.approveRelease": [ "Staff.BillingManager" ],
        // SL4-BIL-DISBOPS: stop/void need BIL.DisbursementStop authority (checked again by the handler); CLM calls them in process for payment corrections.
        "bil.Disbursement.stop": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        "bil.Disbursement.void": [ "Staff.Billing", "Staff.BillingManager", "Staff.ClaimsHandler", "Staff.ClaimsManager", "Platform.Admin" ],
        // BO-BIL-10: bank-file batches of non-claim disbursements; the release is approved by a second person (SoD checked by the handler).
        "bil.DisbursementBatch.prepare": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.DisbursementBatch.release": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.DisbursementBatch.approveRelease": [ "Staff.BillingManager" ],
        // Development-only manual stub bank (Billing:StubBank:Mode=Manual); the controller answers 404 elsewhere.
        "bil.DevBank.operate": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        // SL3-PLT-SUPPORT: refunds are read by billing staff; only the billing manager decides them (SoD: maker != checker is enforced by plt.Approval).
        "bil.Refund.get": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Refund.list": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Refund.decide": [ "Staff.BillingManager" ],
        // SL3-BIL-REFUND: billing staff (and the manager) propose and resubmit; maker != checker is enforced by plt.Approval and by BIL.
        "bil.Refund.propose": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Refund.resubmit": [ "Staff.Billing", "Staff.BillingManager" ],
        // SL6-BIL-DELINQ: collections staff work the non-payment cases; the manager also lifts holds.
        "bil.Delinquency.get": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Delinquency.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Delinquency.recordContact": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Delinquency.arrange": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Delinquency.releaseHold": [ "Staff.Billing", "Staff.BillingManager" ],
        // NX-HD-08c: levy/IPT accrual reads (finance + billing manager) and the migrated-records inspection lists (billing staff).
        "bil.TaxLevy.periods": [ "Staff.Finance", "Staff.BillingManager", "Platform.Admin" ],
        "bil.TaxLevy.detail": [ "Staff.Finance", "Staff.BillingManager", "Platform.Admin" ],
        // BO-BIL-14: the levy payment request is a BIL.DISBURSEMENT act like bil.Disbursement.request; a second person approves the release.
        "bil.TaxLevy.requestLevyPayment": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.MigratedRecord.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        // NX-UI-14c: suspense workbench list and plan instances for the billing operations screens.
        "bil.Suspense.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        // BO-BIL-08: suggest/transfer by billing staff; refund-to-sender only proposes a refund (a second person decides it with bil.Refund.decide).
        "bil.Suspense.suggest": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ],
        "bil.Suspense.transfer": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Suspense.refundToSender": [ "Staff.Billing", "Staff.BillingManager" ],
        // BO-BIL-11: the statement import records money (billing staff); the invariant report is read-only (billing, finance).
        "bil.Reconciliation.bank": [ "Staff.Billing", "Staff.BillingManager" ],
        "bil.Reconciliation.invariants": [ "Staff.Billing", "Staff.BillingManager", "Staff.Finance", "Platform.Admin" ],
        // BO-BIL-12: ledger reads and the day control totals FIN compares (read-only).
        "bil.Ledger.query": [ "Staff.Billing", "Staff.BillingManager", "Staff.Finance", "Platform.Admin" ],
        "bil.Ledger.balance": [ "Staff.Billing", "Staff.BillingManager", "Staff.Finance", "Platform.Admin" ],
        "bil.Reconciliation.fin": [ "Staff.Billing", "Staff.BillingManager", "Staff.Finance", "Platform.Admin" ],
        "bil.PlanInstance.list": [ "Staff.Billing", "Staff.BillingManager", "Platform.Admin" ]
      }
    },
    "Authority": {
      // ILLUSTRATIVE TEST DATA (D-SL3-14; no approved refund authority matrix exists): refund authority per refund, EUR. Never presented as
      // approved limits; "Illustrative": true grants are ignored in Production (fail closed: DENY). The exact limit is allowed; one cent above
      // refers to the next role (four eyes); above the manager's limit, DENY. payeeChanged is limited on the Staff.Billing grant only ("false"), so a changed payee always refers to the manager.
      "Grants": [
        {
          "Id": "bil-billing-refund-illustrative", "Role": "Staff.Billing", "Type": "BIL.REFUND", "Illustrative": true,
          "Limits": [
            { "Dimension": "amount", "Comparison": "AtMost", "Amount": "500.00", "Currency": "EUR" },
            // SL3-BIL-REFUND (REQ-BIL-188/189): a refund to a changed payee or payee account refers up to the billing manager.
            { "Dimension": "payeeChanged", "Comparison": "InSet", "Codes": [ "false" ] }
          ]
        },
        {
          "Id": "bil-billingmgr-refund-illustrative", "Role": "Staff.BillingManager", "Type": "BIL.REFUND", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        // BO-BIL-09: request and approval of non-claim disbursements by amount (ILLUSTRATIVE, ignored in Production: fail closed).
        {
          "Id": "bil-billing-disb-illustrative", "Role": "Staff.Billing", "Type": "BIL.DISBURSEMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "10000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-billingmgr-disb-illustrative", "Role": "Staff.BillingManager", "Type": "BIL.DISBURSEMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "1000000.00", "Currency": "EUR" } ]
        },
        // BO-BIL-07: reversal of allocations by amount (ILLUSTRATIVE, ignored in Production: fail closed). Above the actor's limit the
        // reversal is refused; the billing manager holds the higher limit.
        {
          "Id": "bil-billing-allocrev-illustrative", "Role": "Staff.Billing", "Type": "BIL.ALLOCATION_REVERSE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-billingmgr-allocrev-illustrative", "Role": "Staff.BillingManager", "Type": "BIL.ALLOCATION_REVERSE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "1000000.00", "Currency": "EUR" } ]
        },
        // BO-BIL-13: approval of a write-off by amount (ILLUSTRATIVE, ignored in Production: fail closed). Only the billing manager decides.
        {
          "Id": "bil-billingmgr-writeoff-illustrative", "Role": "Staff.BillingManager", "Type": "BIL.WRITE_OFF", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        // NX-EC-09: stop/void of a disbursement by amount (ILLUSTRATIVE, ignored in Production: fail closed). A payment above the
        // actor's limit is refused; there is no referral for an immediate correction.
        {
          "Id": "bil-billing-disbstop-illustrative", "Role": "Staff.Billing", "Type": "BIL.DISBURSEMENT_STOP", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "100000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-claimshandler-disbstop-illustrative", "Role": "Staff.ClaimsHandler", "Type": "BIL.DISBURSEMENT_STOP", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "100000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-billingmgr-disbstop-illustrative", "Role": "Staff.BillingManager", "Type": "BIL.DISBURSEMENT_STOP", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "10000000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-claimsmgr-disbstop-illustrative", "Role": "Staff.ClaimsManager", "Type": "BIL.DISBURSEMENT_STOP", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "10000000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "bil-admin-disbstop-illustrative", "Role": "Platform.Admin", "Type": "BIL.DISBURSEMENT_STOP", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "10000000.00", "Currency": "EUR" } ]
        }
      ]
    }
  }
}
