{
  "Platform": {
    "Permissions": {
      "Grants": {
        // Treaty maker (D-SL4-16): the reinsurance accountant enters, edits and submits; the reinsurance manager is the checker.
        "ri.Contract.create": [ "Staff.ReinsuranceAccountant" ],
        "ri.Contract.update": [ "Staff.ReinsuranceAccountant" ],
        "ri.Contract.submit": [ "Staff.ReinsuranceAccountant" ],
        "ri.Contract.approve": [ "Staff.ReinsuranceManager" ],
        // Endorsement (BO-RI-03): the accountant endorses (maker), the manager decides (checker); versionAt is a read.
        "ri.Contract.endorse": [ "Staff.ReinsuranceAccountant" ],
        "ri.Contract.approveEndorsement": [ "Staff.ReinsuranceManager" ],
        "ri.Contract.versionAt": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        // Reads: the reinsurance roles and, for get / applicable, the claims roles (SL4-RI-RECOVERY looks up the treaty for a loss).
        "ri.Contract.get": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "ri.Contract.list": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Platform.Admin" ],
        "ri.Contract.applicable": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        // Recoveries (SL4-RI-RECOVERY): claims roles and RI roles read.
        "ri.Recovery.listByClaim": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "ri.Recovery.listByContract": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        "ri.Recovery.trace": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist", "Staff.ClaimsHandler", "Staff.ClaimsManager" ],
        // Cession, programme and participation reads (NX-HD-08a).
        "ri.Cession.listByPolicy": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Cession.get": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.CessionException.list": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Programme.list": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Programme.get": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Participation.list": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        // Premium accounting (BO-RI-10): the accountant sets schedules and calculates (maker), the manager decides (checker); PLT RI.ADJUSTMENT_APPROVE.
        "ri.DepositSchedule.get": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.DepositSchedule.reschedule": [ "Staff.ReinsuranceAccountant" ],
        "ri.Adjustment.calculate": [ "Staff.ReinsuranceAccountant" ],
        "ri.Adjustment.approve": [ "Staff.ReinsuranceManager" ],
        "ri.Commission.adjust": [ "Staff.ReinsuranceAccountant" ],
        "ri.Commission.approve": [ "Staff.ReinsuranceManager" ],
        "ri.Commission.history": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        // Technical account (BO-RI-11): the accountant generates and reverses items; the reinsurance roles read.
        "ri.Item.generate": [ "Staff.ReinsuranceAccountant" ],
        "ri.Item.reverse": [ "Staff.ReinsuranceAccountant" ],
        "ri.Item.list": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Balance.report": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        // Reinsurer statements (BO-RI-14): the accountant generates, submits, issues, records the answer and reissues; the manager is the checker.
        "ri.Statement.generate": [ "Staff.ReinsuranceAccountant" ],
        "ri.Statement.submit": [ "Staff.ReinsuranceAccountant" ],
        "ri.Statement.approve": [ "Staff.ReinsuranceManager" ],
        "ri.Statement.issue": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager" ],
        "ri.Statement.recordResponse": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager" ],
        "ri.Statement.reissue": [ "Staff.ReinsuranceAccountant" ],
        // BO-RI-08: restatement, occurrences, adjustments and the aggregate tracker. The adjustment's real gate is the RI.RECOVERY_ADJUSTMENT authority.
        "ri.Recovery.recalculate": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Occurrence.link": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Occurrence.unlink": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ],
        "ri.Recovery.adjust": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager" ],
        "ri.AggregateTracker.get": [ "Staff.ReinsuranceAccountant", "Staff.ReinsuranceManager", "Staff.RecoverySpecialist" ]
      }
    },
    "Authority": {
      // ILLUSTRATIVE TEST DATA (D-SL4-04, D-SL4-16; PRD-08 §11 authority matrix is not approved): the reinsurance manager may
      // approve (or return) a per-risk XoL treaty. Never presented as an approved limit; "Illustrative": true grants are
      // ignored in Production (fail closed: DENY). Separation of duties is not configuration: the maker, the editors and the
      // submitter can never approve their own treaty.
      "Grants": [
        {
          "Id": "ri-manager-contract-approve-illustrative", "Role": "Staff.ReinsuranceManager", "Type": "RI.CONTRACT_APPROVE", "Illustrative": true,
          "Limits": [ { "Dimension": "contractType", "Comparison": "InSet", "Codes": [ "XOL_PER_RISK" ] } ]
        },
        // BO-RI-10 (ILLUSTRATIVE, ignored in Production): adjustment premium / commission approval by absolute amount, EUR. Above the accountant's
        // limit refers to the manager (four eyes); above the manager's limit DENY.
        {
          "Id": "ri-accountant-adjustment-illustrative", "Role": "Staff.ReinsuranceAccountant", "Type": "RI.ADJUSTMENT_APPROVE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "ri-manager-adjustment-illustrative", "Role": "Staff.ReinsuranceManager", "Type": "RI.ADJUSTMENT_APPROVE", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000000.00", "Currency": "EUR" } ]
        },
        // BO-RI-08 (ILLUSTRATIVE, ignored in Production): a manual recovery adjustment by amount. The manager may adjust up to EUR 100,000;
        // the accountant up to EUR 5,000. Above the actor's limit the adjustment is refused.
        {
          "Id": "ri-manager-recovery-adjust-illustrative", "Role": "Staff.ReinsuranceManager", "Type": "RI.RECOVERY_ADJUSTMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "100000.00", "Currency": "EUR" } ]
        },
        {
          "Id": "ri-accountant-recovery-adjust-illustrative", "Role": "Staff.ReinsuranceAccountant", "Type": "RI.RECOVERY_ADJUSTMENT", "Illustrative": true,
          "Limits": [ { "Dimension": "amount", "Comparison": "AtMost", "Amount": "5000.00", "Currency": "EUR" } ]
        }
      ]
    }
  }
}
