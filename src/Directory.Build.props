<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Production code rules.
    COREINS001 (tools/CoreIns.Analyzers) forbids floating point - System.Double / System.Single, i.e. `double` and
    `float` - anywhere in production code: declarations, literals, conversions and generic arguments. Money, rates and
    percentages are decimal (ARCHITECTURE-DECISIONS §2 rule 2). Violations are build errors.
    (Microsoft.CodeAnalysis.BannedApiAnalyzers was evaluated and rejected: RS0030 does not report keyword types,
    literals or implicit conversions, so `double x = 1.5;` passes it.)
    COREINS002 (same project) forbids reading the system clock (DateTime.Now/UtcNow/Today, DateTimeOffset.Now/UtcNow,
    TimeProvider.System): the current time comes only from CoreIns.Platform.Time.IClock (contract §3.9.13,
    REQ-PLT-332). Only SystemClock suppresses it; CoreIns.ArchitectureTests checks that.
  -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\tools\CoreIns.Analyzers\CoreIns.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
