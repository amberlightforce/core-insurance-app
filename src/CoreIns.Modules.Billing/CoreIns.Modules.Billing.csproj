<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PRD-06 Billing: implementation of the Billing module (PostgreSQL schema `bil`).
    SL-BIL: charge intake, account, ANNUAL invoice, fiscal request (CMP), payment and allocation, append-only sub-ledger.
    Other modules are reached only through their generated *.Contracts interfaces and events.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreIns.Modules.Billing.Contracts\CoreIns.Modules.Billing.Contracts.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Policy.Contracts\CoreIns.Modules.Policy.Contracts.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Product.Contracts\CoreIns.Modules.Product.Contracts.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Compliance.Contracts\CoreIns.Modules.Compliance.Contracts.csproj" />
    <ProjectReference Include="..\CoreIns.Modules.Market.Contracts\CoreIns.Modules.Market.Contracts.csproj" />
    <!-- SL2-BIL-DISB: sanctions screening of payees through pty.Screening.screen (contract only). -->
    <ProjectReference Include="..\CoreIns.Modules.Party.Contracts\CoreIns.Modules.Party.Contracts.csproj" />
    <ProjectReference Include="..\CoreIns.Platform\CoreIns.Platform.csproj" />
    <!-- IBANs are P2: field encryption and blind index (D-ARC-14). -->
    <ProjectReference Include="..\CoreIns.Platform.DataProtection\CoreIns.Platform.DataProtection.csproj" />
    <ProjectReference Include="..\CoreIns.SharedKernel\CoreIns.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CoreIns.IntegrationTests" />
    <InternalsVisibleTo Include="CoreIns.ArchitectureTests" />
  </ItemGroup>

</Project>
