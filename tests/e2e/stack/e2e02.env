# Environment of the isolated E2E-02a stack (compose project "coreins-e2e02"). Synthetic data only; every value is a local
# placeholder. Copy of infra/local/.env.example with its own passwords and host ports in the 26500 range, so the stack
# can run beside a developer's own "coreins" stack (ports 25000+/5000+) without touching it.

PG_PASSWORD=e2e02-superuser
APP_DB_PASSWORD=e2e02-app
MIGRATOR_DB_PASSWORD=e2e02-migrator

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Core=Host=postgres;Database=coreins;Username=app;Password=e2e02-app
ConnectionStrings__Migrator=Host=postgres;Database=coreins;Username=migrator;Password=e2e02-migrator

Blob__ServiceUri=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
Blob__UseManagedIdentity=false

AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000

DocRender__Url=http://gotenberg:3000
Email__Provider=Smtp
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:18889

Ai__Enabled=false
Stamp__Id=local
Stamp__LegalEntity=GR-TEST
Stamp__Country=GR

DevAuthentication__Enabled=true
DataProtection__LocalMasterKey=Y29yZWlucy1sb2NhbC1kZXYtb25seS1ub3QtYS1rZXk=
Party__DefaultCallingCode=30

# Host ports (127.0.0.1 only), 26500 range.
API_HOST_PORT=26500
PG_HOST_PORT=26532
AZURITE_HOST_PORT=26510
GOTENBERG_HOST_PORT=26530
MAILPIT_UI_HOST_PORT=26525
MAILPIT_SMTP_HOST_PORT=26526
WIREMOCK_HOST_PORT=26589
OTEL_UI_HOST_PORT=26588
OTEL_HOST_PORT=26517
