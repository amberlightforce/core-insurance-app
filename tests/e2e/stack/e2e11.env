# Environment of the isolated E2E-11 stack (compose project "coreins-e2e11"). Synthetic data only; every value is a local
# placeholder. Copy of infra/local/.env.example with its own passwords and host ports in the 33000 range, so the stack
# can run beside a developer's own "coreins" stack (ports 25000+/5000+) without touching it.

PG_PASSWORD=e2e11-superuser
APP_DB_PASSWORD=e2e11-app
MIGRATOR_DB_PASSWORD=e2e11-migrator

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Core=Host=postgres;Database=coreins;Username=app;Password=e2e11-app
ConnectionStrings__Migrator=Host=postgres;Database=coreins;Username=migrator;Password=e2e11-migrator

Blob__ServiceUri=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
Blob__UseManagedIdentity=false

AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000

DocRender__Url=http://gotenberg:3000
Email__Provider=Smtp
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:18889

Ai__Enabled=false
Stamp__Id=local
Stamp__LegalEntity=GR-TEST
Stamp__Country=GR

DevAuthentication__Enabled=true
# Dev tokens are checked against the shiftable clock: keep them valid across the journeys' clock advances (up to about a year and a half).
DevAuthentication__TokenLifetimeMinutes=1051200
DataProtection__LocalMasterKey=Y29yZWlucy1sb2NhbC1kZXYtb25seS1ub3QtYS1rZXk=
Party__DefaultCallingCode=30

# Shiftable clock (D-SL3-12): the dev clock endpoint advances time for api and worker; refused at startup in Production.
Platform__Time__Mode=Shiftable

# Host ports (127.0.0.1 only), 33000 range.
API_HOST_PORT=33000
PG_HOST_PORT=33032
AZURITE_HOST_PORT=33010
GOTENBERG_HOST_PORT=33030
MAILPIT_UI_HOST_PORT=33025
MAILPIT_SMTP_HOST_PORT=33026
WIREMOCK_HOST_PORT=33089
OTEL_UI_HOST_PORT=33088
OTEL_HOST_PORT=33017

# Premium cession (RI-CESSION-DELTA, D-SL6-10): one ILLUSTRATIVE 30 percent quota share over the motor covers; none is seeded.
Reinsurance__Cession__Mode=Net
Reinsurance__Cession__Treaties__0__TreatyId=QS-E2E11
Reinsurance__Cession__Treaties__0__Kind=QUOTA_SHARE
Reinsurance__Cession__Treaties__0__ContractYear=2026
Reinsurance__Cession__Treaties__0__SharePct=30
Reinsurance__Cession__Treaties__0__CoverageCodes__0=MTPL
Reinsurance__Cession__Treaties__0__CoverageCodes__1=OWN-DAMAGE
Reinsurance__Cession__Treaties__0__ValidFrom=2026-01-01
Reinsurance__Cession__Treaties__0__ValidTo=2036-01-01
