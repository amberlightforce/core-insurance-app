# Environment of the isolated E2E-06 stack (compose project "coreins-e2e06"). Synthetic data only; every value is a local
# placeholder (System clock, no time shift). Copy of infra/local/.env.example with its own passwords and host ports in the 33000 range, so the stack
# can run beside a developer's own "coreins" stack (ports 25000+/5000+) without touching it.

PG_PASSWORD=e2e06-superuser
APP_DB_PASSWORD=e2e06-app
MIGRATOR_DB_PASSWORD=e2e06-migrator

ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Core=Host=postgres;Database=coreins;Username=app;Password=e2e06-app
ConnectionStrings__Migrator=Host=postgres;Database=coreins;Username=migrator;Password=e2e06-migrator

Blob__ServiceUri=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
Blob__UseManagedIdentity=false

AzureAd__TenantId=00000000-0000-0000-0000-000000000000
AzureAd__ClientId=00000000-0000-0000-0000-000000000000

DocRender__Url=http://gotenberg:3000
Email__Provider=Smtp
Email__Smtp__Host=mailpit
Email__Smtp__Port=1025

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:18889

Ai__Enabled=false
Stamp__Id=local
Stamp__LegalEntity=GR-TEST
Stamp__Country=GR

DevAuthentication__Enabled=true
DataProtection__LocalMasterKey=Y29yZWlucy1sb2NhbC1kZXYtb25seS1ub3QtYS1rZXk=
Party__DefaultCallingCode=30


# Host ports (127.0.0.1 only), 33000 range.
API_HOST_PORT=33000
PG_HOST_PORT=33032
AZURITE_HOST_PORT=33010
GOTENBERG_HOST_PORT=33030
MAILPIT_UI_HOST_PORT=33025
MAILPIT_SMTP_HOST_PORT=33026
WIREMOCK_HOST_PORT=33089
OTEL_UI_HOST_PORT=33088
OTEL_HOST_PORT=33017

# Slice 4: the manual stub bank holds every released payment at Released until /dev/bank/disbursements/{id}/issue|clear moves it on.
Billing__StubBank__Mode=Manual

# Friendly Settlement stub (GR pack, never bound in Production). Counterparty insurers are organisation parties created by the test, so their
# ids are unknown here: the member list accepts any code ("*"). Their clearing payee accounts are registered at run time through
# POST /api/clm/v1/dev/fs-clearing/clearing-payee-accounts.
FriendlySettlement__Stub__OwnInsurerCode=OWN-INSURER
FriendlySettlement__Stub__MemberCodes__0=OWN-INSURER
FriendlySettlement__Stub__MemberCodes__1=*

# Shiftable clock (D-SL3-12, NX-TST-02): specs advance the dev clock instead of waiting on the wall clock.
Platform__Time__Mode=Shiftable
