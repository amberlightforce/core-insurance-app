{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/ri/CatOccurrenceConfirmed.v1.schema.json",
  "title": "CatOccurrenceConfirmed v1",
  "description": "Windows confirmed or revised (REQ-RI-141)",
  "x-event-type": "CatOccurrenceConfirmed",
  "x-registry-name": "ri.CatOccurrenceConfirmed",
  "x-producer": "RI",
  "x-topic": "ri.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "ri_contract_id",
  "x-aggregate-type": [
    "RiContract"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "riContractId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-08 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "CatOccurrenceConfirmed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RI"
    },
    "aggregateType": {
      "const": "RiContract"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "riContractId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catCode",
        "windows",
        "decidedBy"
      ],
      "properties": {
        "catCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/TimeWindow"
          },
          "x-classification": "P0"
        },
        "decidedBy": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        }
      }
    }
  }
}
