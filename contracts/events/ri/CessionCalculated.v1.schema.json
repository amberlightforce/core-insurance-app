    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cessionIds",
        "sourceChargeIds",
        "termId",
        "riskKey",
        "interval",
        "riContractId",
        "sectionId",
        "participantPartyId",
        "cededAmount",
        "commissionAmount",
        "share",
        "postingKey",
        "siiLob",
        "sourceCorrelationKey",
        "deltaSetId"
      ],
      "properties": {
        "cessionIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "sourceChargeIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "termId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "riskKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "interval": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "riContractId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "sectionId": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "participantPartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "cededAmount": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency4",
          "x-classification": "P0"
        },
        "commissionAmount": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency4",
          "x-classification": "P0"
        },
        "share": {
          "$ref": "../common.schema.json#/$defs/Decimal",
          "x-classification": "P0"
        },
        "postingKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "siiLob": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "underlyingIfrs17GroupRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "riHeldGroupRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "sourceCorrelationKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "deltaSetId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        }
      }
    }
