{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/ri/RecoveryCalculated.v1.schema.json",
  "title": "RecoveryCalculated v1",
  "description": "Recovery deltas booked in a batch (REQ-RI-003, REQ-RI-118)",
  "x-event-type": "RecoveryCalculated",
  "x-registry-name": "ri.RecoveryCalculated",
  "x-producer": "RI",
  "x-topic": "ri.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "ri_contract_id",
  "x-aggregate-type": [
    "RiContract"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "riContractId",
    "batchId",
    "participantPartyId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-08 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RecoveryCalculated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RI"
    },
    "aggregateType": {
      "const": "RiContract"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "riContractId",
        "batchId",
        "participantPartyId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchId",
        "recoveryIds",
        "occurrence",
        "claimIds",
        "riContractId",
        "layerId",
        "participantPartyId",
        "incurredDelta",
        "paidDelta",
        "outstandingDelta",
        "claimLevelTotals",
        "postingKey",
        "siiLob",
        "ifrs17Refs"
      ],
      "properties": {
        "batchId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "recoveryIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "occurrence": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "claimIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "riContractId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "layerId": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0",
          "description": "Layer of this delta (the layer number as text); one event is published per layer × participant delta of a batch (D-SL4-05), so layerId, participantPartyId and the three deltas are the delta[layer, participant, incurred, paid, outstanding] of the plan"
        },
        "participantPartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "incurredDelta": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency4",
          "x-classification": "P0"
        },
        "paidDelta": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency4",
          "x-classification": "P0"
        },
        "outstandingDelta": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency4",
          "x-classification": "P0"
        },
        "claimLevelTotals": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ClaimLevelTotal"
          },
          "x-classification": "P0"
        },
        "postingKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0",
          "description": "Posting key as text (item RECOVERY, contract type, direction CEDED, line, participant type; REQ-RI-234); the structured form is posting"
        },
        "siiLob": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "ifrs17Refs": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          },
          "x-classification": "P0"
        },
        "contractYear": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/NonNegativeInt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Contract year of the recalculation (REQ-RI-233); RI always sets it",
          "x-classification": "P0"
        },
        "contractType": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Contract type of the contract (XOL_PER_RISK in slice 4); RI always sets it",
          "x-classification": "P0"
        },
        "posting": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "item",
                "contractType",
                "direction",
                "line",
                "participantType"
              ],
              "properties": {
                "item": {
                  "type": "string",
                  "enum": [
                    "RECOVERY"
                  ],
                  "description": "RI item type"
                },
                "contractType": {
                  "$ref": "../common.schema.json#/$defs/Code"
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "CEDED"
                  ]
                },
                "line": {
                  "$ref": "../common.schema.json#/$defs/Code",
                  "description": "Line of the layer, e.g. L1"
                },
                "participantType": {
                  "$ref": "../common.schema.json#/$defs/Code",
                  "description": "Participant type, e.g. REINSURER"
                }
              }
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured posting key (REQ-RI-234); RI always sets it",
          "x-classification": "P0"
        },
        "ifrs17GroupRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "RI-held IFRS 17 group reference; UNASSIGNED in slice 4 (D-SL4-10). RI always sets it",
          "x-classification": "P0"
        },
        "sourceCorrelationKey": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Source correlation key for FIN lineage (REQ-RI-233); not the W3C trace id. RI always sets it",
          "x-classification": "P0"
        }
      }
    }
  }
}
