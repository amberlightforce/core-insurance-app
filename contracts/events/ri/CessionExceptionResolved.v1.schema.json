{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/ri/CessionExceptionResolved.v1.schema.json",
  "title": "CessionExceptionResolved v1",
  "description": "Exception resolved (REQ-RI-100)",
  "x-event-type": "CessionExceptionResolved",
  "x-registry-name": "ri.CessionExceptionResolved",
  "x-producer": "RI",
  "x-topic": "ri.events.v1",
