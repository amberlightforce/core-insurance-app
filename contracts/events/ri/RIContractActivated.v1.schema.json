{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/ri/RIContractActivated.v1.schema.json",
  "title": "RIContractActivated v1",
  "description": "Approved version reaches period start (REQ-RI-058)",
  "x-event-type": "RIContractActivated",
  "x-registry-name": "ri.RIContractActivated",
  "x-producer": "RI",
  "x-topic": "ri.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "ri_contract_id",
  "x-aggregate-type": [
    "RiContract"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "riContractId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-08 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RIContractActivated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RI"
    },
    "aggregateType": {
      "const": "RiContract"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "riContractId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riContractId",
        "contractNumber",
        "stableTreatyId",
        "year",
        "version",
        "contractType",
        "period",
        "currency",
        "sectionsAndLayers",
        "participants"
      ],
      "properties": {
        "riContractId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "contractNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "stableTreatyId": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "year": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "version": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "contractType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Contract type (open Code). Slice 4 activates XOL_PER_RISK only (D-SL4-04); the PRD values QUOTA_SHARE, SURPLUS, FAC_PROPORTIONAL, FAC_XOL, AUTO_FAC, XOL_PER_EVENT, CAT_XOL, AGGREGATE_XOL and STOP_LOSS are refused with RI-ERR-VALIDATION."
        },
        "period": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0",
          "description": "Half-open period [from, to) in Europe/Athens dates; the contract activates at the period start"
        },
        "currency": {
          "$ref": "../common.schema.json#/$defs/CurrencyCode",
          "x-classification": "P0"
        },
        "sectionsAndLayers": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/OpenObject"
          },
          "x-classification": "P0"
        },
        "participants": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Participant"
          },
          "x-classification": "P0"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/RiLayer"
          },
          "description": "Layers of the contract (attachment, limit, AAD, AAL). RI always sets them for XOL_PER_RISK; sectionsAndLayers stays an OpenObject for later contract types.",
          "x-classification": "P0"
        },
        "placedPct": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Decimal"
            },
            {
              "type": "null"
            }
          ],
          "description": "Placed percentage of the contract (the signed lines of the participants sum to it); RI always sets it",
          "x-classification": "P0"
        },
        "recoveriesInure": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clause: how recoveries reduce ultimate net loss (REALISED_ONLY in slice 4, D-SL4-05); RI always sets it",
          "x-classification": "P0"
        },
        "alaeIncluded": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clause: ALAE is part of ultimate net loss; RI always sets it",
          "x-classification": "P0"
        },
        "statutoryInterestIncluded": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clause: statutory interest is part of ultimate net loss; RI always sets it",
          "x-classification": "P0"
        },
        "productCodes": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "description": "Scope: product codes the contract covers (RI always sets them)",
          "x-classification": "P0"
        },
        "coverageCodes": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "description": "Scope: coverage codes the contract covers (RI always sets them)",
          "x-classification": "P0"
        }
      }
    }
  }
}
