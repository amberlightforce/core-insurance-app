{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/ri/FacPlacementBound.v1.schema.json",
  "title": "FacPlacementBound v1",
  "description": "Fac bound (REQ-RI-107)",
  "x-event-type": "FacPlacementBound",
  "x-registry-name": "ri.FacPlacementBound",
  "x-producer": "RI",
  "x-topic": "ri.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "ri_contract_id",
  "x-aggregate-type": [
    "RiContract"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "riContractId",
    "policyTermId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-08 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "FacPlacementBound"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RI"
    },
    "aggregateType": {
      "const": "RiContract"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "riContractId",
        "policyTermId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificateNumber",
        "policyTermId",
        "riskKey",
        "share",
        "premiumTerms"
      ],
      "properties": {
        "certificateNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "policyTermId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "riskKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "share": {
          "$ref": "../common.schema.json#/$defs/Decimal",
          "x-classification": "P0"
        },
        "premiumTerms": {
          "$ref": "../common.schema.json#/$defs/NamedAmounts",
          "description": "Named premium terms: amounts (Money) or rates (decimal strings)",
          "x-classification": "P0"
        }
      }
    }
  }
}
