{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/BillingEntryPosted.v1.schema.json",
  "title": "BillingEntryPosted v1",
  "description": "Every ledger entry. FIN's sole posting source for BIL facts (REQ-FIN-036). Keyed on legal_entity_id for non-account entries; disbursement entries (DISBURSEMENT_RELEASED, DISBURSEMENT_CLEARED) are keyed on the disbursement (SL2-BIL-DISB).",
  "x-event-type": "BillingEntryPosted",
  "x-registry-name": "bil.BillingEntryPosted",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount",
    "LegalEntity",
    "Disbursement"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "entryId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "BillingEntryPosted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "enum": [
        "BillingAccount",
        "LegalEntity",
        "Disbursement"
      ]
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "entryId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "eventType",
        "accountingDate",
        "businessDate",
        "lines"
      ],
      "properties": {
        "entryId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "eventType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Entry type (open Code). Slice 3 adds CREDIT_WRITTEN (reversal of the written premium receivable by a credit), CREDIT_BILLED (reversal of the billed receivable by a credit note) and REFUND_APPROVED (credit moved to refunds payable on approval). Disbursement entries (DISBURSEMENT_RELEASED, DISBURSEMENT_CLEARED) carry the source type BIL_REFUND for policy refunds. Servicing entries always carry the line dimensions transactionKind, cancellationSource (cancellations) and treatmentRuleId (tax and levy lines)."
        },
        "accountingDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "businessDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/LedgerLine"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
