{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/InvoiceIssued.v1.schema.json",
  "title": "InvoiceIssued v1",
  "description": "Invoice or credit note Billed. BIL invoices are non-fiscal payment demands; fiscal numbers come from CMP (D3).",
  "x-event-type": "InvoiceIssued",
  "x-registry-name": "bil.InvoiceIssued",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "billingAccountId",
    "invoiceId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "InvoiceIssued"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "BillingAccount"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "billingAccountId",
        "invoiceId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoiceId",
        "invoiceNumber",
        "kind",
        "termIds",
        "totalsByCategory",
        "dueDate",
        "method"
      ],
      "properties": {
        "invoiceId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "invoiceNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "INVOICE",
            "CREDIT_NOTE"
          ],
          "x-classification": "P0"
        },
        "termIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "totalsByCategory": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/CategoryTotal"
          },
          "x-classification": "P0"
        },
        "dueDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "method": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "originalInvoiceId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "description": "For kind CREDIT_NOTE, the invoice it corrects (REQ-BIL-091). Always set for a credit note, absent for an INVOICE. Additive (SL3-BIL-CREDIT).",
          "x-classification": "P0"
        },
        "fiscalTriggerRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
