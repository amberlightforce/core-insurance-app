{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/PaymentReversed.v1.schema.json",
  "title": "PaymentReversed v1",
  "description": "Reversal processed",
  "x-event-type": "PaymentReversed",
  "x-registry-name": "bil.PaymentReversed",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentReversed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "BillingAccount"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "reversalId",
        "kind",
        "reasonCategory",
        "reasonCode",
        "amount",
        "itemsReopened",
        "downPayment"
      ],
      "properties": {
        "receiptId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "reversalId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "kind": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "reasonCategory": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "reasonCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        },
        "itemsReopened": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "downPayment": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
