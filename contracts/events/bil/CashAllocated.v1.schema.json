{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/CashAllocated.v1.schema.json",
  "title": "CashAllocated v1",
  "description": "Allocation batch committed",
  "x-event-type": "CashAllocated",
  "x-registry-name": "bil.CashAllocated",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "billingAccountId",
    "receiptId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "CashAllocated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "BillingAccount"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "billingAccountId",
        "receiptId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "allocations",
        "arrearsCleared",
        "downPayment"
      ],
      "properties": {
        "receiptId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Allocation"
          },
          "x-classification": "P0"
        },
        "arrearsCleared": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/TermArrearsFlag"
          },
          "description": "arrears_cleared per term",
          "x-classification": "P0"
        },
        "downPayment": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "receivableId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "BIL receivable the cash settled (D-SL4-06). Always set when the receipt pays a CLM receivable, null for policy cash",
          "x-classification": "P0"
        },
        "receivableAmount": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "description": "Amount allocated to the receivable. Always set when receivableId is set",
          "x-classification": "P0"
        },
        "allocationId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "BIL allocation id: the evidence CLM records the recovery against. Always set when receivableId is set",
          "x-classification": "P0"
        },
        "claimId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Claim of the receivable. Always set when receivableId is set and the receivable names a claim",
          "x-classification": "P0"
        },
        "recoveryId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "CLM recovery of the receivable. Always set for SALVAGE and SUBROGATION receivables",
          "x-classification": "P0"
        },
        "statementRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Friendly Settlement statement reference. Always set for FS_CLEARING receivables",
          "x-classification": "P0"
        },
        "sourceType": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/DisbursementSourceType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Receivable source type (CLM_CLAIM_PAYMENT or FS_CLEARING). Always set when receivableId is set",
          "x-classification": "P0"
        }
      }
    }
  }
}
