{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/LevyRemitted.v1.schema.json",
  "title": "LevyRemitted v1",
  "description": "Levy payment Cleared. Keyed on levy_period_id (PRD-06 applies XMR-F-117).",
  "x-event-type": "LevyRemitted",
  "x-registry-name": "bil.LevyRemitted",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "levy_period_id",
  "x-aggregate-type": [
    "TaxLevyPeriod"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "levyPeriodId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "LevyRemitted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "TaxLevyPeriod"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "levyPeriodId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levyType",
        "period",
        "amount",
        "valueDate"
      ],
      "properties": {
        "levyType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "period": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        },
        "valueDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        }
      }
    }
  }
}
