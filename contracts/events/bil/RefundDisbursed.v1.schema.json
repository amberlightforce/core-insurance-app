{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/RefundDisbursed.v1.schema.json",
  "title": "RefundDisbursed v1",
  "description": "Refund disbursement accepted by the bank (ISSUED), per D-CON-10. Fires when the bank accepts the payment file (ISSUED), per D-CON-10 as amended by D-CON-10a, although PRD-06 words the trigger as Cleared. Stops POL_REFUND_DUE. Per D-CON-10a there is no RefundCleared event; clearing is covered by DisbursementCleared.",
  "x-event-type": "RefundDisbursed",
  "x-registry-name": "bil.RefundDisbursed",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "billingAccountId",
    "refundId",
    "disbursementId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RefundDisbursed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "BillingAccount"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "billingAccountId",
        "refundId",
        "disbursementId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refundId",
        "disbursementId",
        "amount",
        "valueDate",
        "sourcePolicyIds"
      ],
      "properties": {
        "refundId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "disbursementId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        },
        "valueDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "sourcePolicyIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
