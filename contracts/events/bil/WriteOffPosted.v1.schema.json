{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/bil/WriteOffPosted.v1.schema.json",
  "title": "WriteOffPosted v1",
  "description": "Write-off posted",
  "x-event-type": "WriteOffPosted",
  "x-registry-name": "bil.WriteOffPosted",
  "x-producer": "BIL",
  "x-topic": "bil.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "billing_account_id",
  "x-aggregate-type": [
    "BillingAccount"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-06 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "WriteOffPosted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "BIL"
    },
    "aggregateType": {
      "const": "BillingAccount"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "writeOffId",
        "type",
        "reason",
        "itemIds",
        "amount"
      ],
      "properties": {
        "writeOffId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "type": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "itemIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        }
      }
    }
  }
}
