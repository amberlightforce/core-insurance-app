{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/ApprovalInvalidated.v1.schema.json",
  "title": "ApprovalInvalidated v1",
  "description": "Approval invalidated",
  "x-event-type": "ApprovalInvalidated",
  "x-registry-name": "uw.ApprovalInvalidated",
  "x-producer": "UW",
  "x-topic": "uw.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "job_id",
  "x-aggregate-type": [
    "Job"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-04 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ApprovalInvalidated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "UW"
    },
    "aggregateType": {
      "const": "Job"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "issueId",
        "approvalId",
        "reason",
        "changedFieldCodes"
      ],
      "properties": {
        "jobId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "issueId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "approvalId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "reason": {
          "type": "string",
          "enum": [
            "VALUE_CHANGED",
            "EXPIRED",
            "SCOPE",
            "MANUAL_REOPEN",
            "RULE_MAJOR_CHANGE"
          ],
          "x-classification": "P0"
        },
        "changedFieldCodes": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
