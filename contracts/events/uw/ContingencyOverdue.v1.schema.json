{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/ContingencyOverdue.v1.schema.json",
  "title": "ContingencyOverdue v1",
  "description": "Due date passed unsatisfied",
  "x-event-type": "ContingencyOverdue",
  "x-registry-name": "uw.ContingencyOverdue",
  "x-producer": "UW",
  "x-topic": "uw.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "term_id",
  "x-aggregate-type": [
    "PolicyTerm"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "policyTermId",
    "contingencyId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-04 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ContingencyOverdue"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "UW"
    },
    "aggregateType": {
      "const": "PolicyTerm"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "policyTermId",
        "contingencyId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contingencyId",
        "termId",
        "dueDate",
        "consequenceCode"
      ],
      "properties": {
        "contingencyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "termId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "dueDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "consequenceCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
