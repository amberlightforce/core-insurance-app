{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/DeclineIssued.v1.schema.json",
  "title": "DeclineIssued v1",
  "description": "Decline committed. Keyed on job_id, or the intake id for declines before a job exists.",
  "x-event-type": "DeclineIssued",
  "x-registry-name": "uw.DeclineIssued",
  "x-producer": "UW",
  "x-topic": "uw.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "job_id",
  "x-aggregate-type": [
    "Job",
    "SubmissionIntake"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-04 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "DeclineIssued"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "UW"
    },
    "aggregateType": {
      "enum": [
        "Job",
        "SubmissionIntake"
      ]
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declineId",
        "declineNumber",
        "scope",
        "reasonCodes",
        "declinedPairs",
        "automated"
      ],
      "properties": {
        "declineId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "declineNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "jobId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "intakeId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "scope": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        },
        "declinedPairs": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/OpenObject"
          },
          "x-classification": "P0"
        },
        "automated": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
