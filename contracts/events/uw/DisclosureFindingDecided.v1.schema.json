{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/DisclosureFindingDecided.v1.schema.json",
  "title": "DisclosureFindingDecided v1",
  "description": "Non-disclosure or aggravation decision taken",
  "x-event-type": "DisclosureFindingDecided",
  "x-registry-name": "uw.DisclosureFindingDecided",
  "x-producer": "UW",
  "x-topic": "uw.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "term_id",
  "x-aggregate-type": [
    "PolicyTerm"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "policyTermId",
    "findingId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-04 §8.2",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "DisclosureFindingDecided"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "UW"
    },
    "aggregateType": {
      "const": "PolicyTerm"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "policyTermId",
        "findingId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "kind",
        "decision"
      ],
      "properties": {
        "findingId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "NON_DISCLOSURE",
            "AGGRAVATION"
          ],
          "x-classification": "P0"
        },
        "decision": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "polJobId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
