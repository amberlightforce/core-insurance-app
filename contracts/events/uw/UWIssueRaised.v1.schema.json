{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/UWIssueRaised.v1.schema.json",
  "title": "UWIssueRaised v1",
  "description": "Issue enters Open (new, reopened, or after invalidation)",
  "x-event-type": "UWIssueRaised",
  "x-registry-name": "uw.UWIssueRaised",
  "x-producer": "UW",
  "x-topic": "uw.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "job_id",
  "x-aggregate-type": [
    "Job"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-04 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "UWIssueRaised"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "UW"
    },
    "aggregateType": {
      "const": "Job"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "issueId",
        "issueType",
        "issueKeyHash",
        "blockingPoint",
        "severity",
        "lane",
        "reopened"
      ],
      "properties": {
        "jobId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "issueId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "issueType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "issueKeyHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "blockingPoint": {
          "$ref": "../common.schema.json#/$defs/BlockingPoint",
          "x-classification": "P0"
        },
        "severity": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "lane": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "reopened": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
