{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/RenewalDirectionSet.v1.schema.json",
  "title": "RenewalDirectionSet v1",
  "description": "Renewal direction set or changed",
