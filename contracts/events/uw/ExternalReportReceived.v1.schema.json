{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/uw/ExternalReportReceived.v1.schema.json",
  "title": "ExternalReportReceived v1",
  "description": "Report received",
