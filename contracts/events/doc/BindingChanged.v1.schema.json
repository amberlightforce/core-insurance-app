{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/doc/BindingChanged.v1.schema.json",
  "title": "BindingChanged v1",
  "description": "Binding row activated or ended",
  "x-event-type": "BindingChanged",
  "x-registry-name": "doc.BindingChanged",
  "x-producer": "DOC",
  "x-topic": "doc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "binding_id",
  "x-aggregate-type": [
    "FormBinding"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "bindingId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-10 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "BindingChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DOC"
    },
    "aggregateType": {
      "const": "FormBinding"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "bindingId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingId",
        "form",
        "language",
        "templateVersion",
        "effectivePeriod"
      ],
      "properties": {
        "bindingId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "productVersionRange": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "documentType": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "form": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "language": {
          "$ref": "../common.schema.json#/$defs/LanguageCode",
          "x-classification": "P0"
        },
        "templateVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "effectivePeriod": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        }
      }
    }
  }
}
