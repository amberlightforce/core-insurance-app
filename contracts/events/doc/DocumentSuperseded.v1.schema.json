{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/doc/DocumentSuperseded.v1.schema.json",
  "title": "DocumentSuperseded v1",
  "description": "Document replaced or withdrawn",
  "x-event-type": "DocumentSuperseded",
  "x-registry-name": "doc.DocumentSuperseded",
  "x-producer": "DOC",
  "x-topic": "doc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "document_id",
  "x-aggregate-type": [
    "Document"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "documentId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-10 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "DocumentSuperseded"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DOC"
    },
    "aggregateType": {
      "const": "Document"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "documentId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "supersededByDocumentId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when withdrawn",
          "x-classification": "P0"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
