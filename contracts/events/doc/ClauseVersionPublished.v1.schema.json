{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/doc/ClauseVersionPublished.v1.schema.json",
  "title": "ClauseVersionPublished v1",
  "description": "Library version published",
  "x-event-type": "ClauseVersionPublished",
  "x-registry-name": "doc.ClauseVersionPublished",
  "x-producer": "DOC",
  "x-topic": "doc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "clause_id",
  "x-aggregate-type": [
    "Clause"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "clauseId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-10 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ClauseVersionPublished"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DOC"
    },
    "aggregateType": {
      "const": "Clause"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "clauseId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clauseId",
        "code",
        "version",
        "languages",
        "effectivePeriod"
      ],
      "properties": {
        "clauseId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "code": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "version": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/LanguageCode"
          },
          "x-classification": "P0"
        },
        "effectivePeriod": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        }
      }
    }
  }
}
