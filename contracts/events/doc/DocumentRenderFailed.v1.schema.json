{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/doc/DocumentRenderFailed.v1.schema.json",
  "title": "DocumentRenderFailed v1",
  "description": "Failure (each final failure; retries not published)",
  "x-event-type": "DocumentRenderFailed",
  "x-registry-name": "doc.DocumentRenderFailed",
  "x-producer": "DOC",
  "x-topic": "doc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "document_id",
  "x-aggregate-type": [
    "Document"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "documentId",
    "failureItemId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-10 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "DocumentRenderFailed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DOC"
    },
    "aggregateType": {
      "const": "Document"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "documentId",
        "failureItemId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentType",
        "subjectRef",
        "failureClass",
        "retryable",
        "failureItemId"
      ],
      "properties": {
        "documentType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "subjectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-classification": "P0"
        },
        "failureClass": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "retryable": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "failureItemId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        }
      }
    }
  }
}
