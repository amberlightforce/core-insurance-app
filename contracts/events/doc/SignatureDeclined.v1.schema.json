{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/doc/SignatureDeclined.v1.schema.json",
  "title": "SignatureDeclined v1",
  "description": "Signatory declined or envelope expired",
  "x-event-type": "SignatureDeclined",
  "x-registry-name": "doc.SignatureDeclined",
  "x-producer": "DOC",
  "x-topic": "doc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "envelope_id",
  "x-aggregate-type": [
    "SignatureEnvelope"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "envelopeId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-10 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "SignatureDeclined"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DOC"
    },
    "aggregateType": {
      "const": "SignatureEnvelope"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "envelopeId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectRef",
        "reason",
        "signatoryRole"
      ],
      "properties": {
        "subjectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-classification": "P0"
        },
        "reason": {
          "type": "string",
          "enum": [
            "DECLINED",
            "EXPIRED"
          ],
          "x-classification": "P0"
        },
        "signatoryRole": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
