{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/dat/RegulatoryMartPublished.v1.schema.json",
  "title": "RegulatoryMartPublished v1",
  "description": "Mart run signed off and handed off (REQ-DAT-115)",
  "x-event-type": "RegulatoryMartPublished",
  "x-registry-name": "dat.RegulatoryMartPublished",
  "x-producer": "DAT",
  "x-topic": "dat.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "mart_run_id",
  "x-aggregate-type": [
    "MartRun"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "martRunId",
    "runId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-15 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RegulatoryMartPublished"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DAT"
    },
    "aggregateType": {
      "const": "MartRun"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "martRunId",
        "runId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mart",
        "legalEntity",
        "period",
        "regime",
        "taxonomyVersion",
        "runId",
        "reconciliationStatus",
        "inputsHash"
      ],
      "properties": {
        "mart": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "legalEntity": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "period": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "regime": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "taxonomyVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "runId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "reconciliationStatus": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "inputsHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "supersedesMartRunId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
