{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/dat/ModelDriftDetected.v1.schema.json",
  "title": "ModelDriftDetected v1",
  "description": "Performance, drift or acceptance metric breaches threshold (REQ-DAT-215)",
  "x-event-type": "ModelDriftDetected",
  "x-registry-name": "dat.ModelDriftDetected",
  "x-producer": "DAT",
  "x-topic": "dat.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "model_id",
  "x-aggregate-type": [
    "Model"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-15 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ModelDriftDetected"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "DAT"
    },
    "aggregateType": {
      "const": "Model"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "modelVersion",
        "metric",
        "value",
        "threshold",
        "window",
        "sampleSize",
        "severity",
        "breachId"
      ],
      "properties": {
        "featureId": {
          "$ref": "../common.schema.json#/$defs/AiFeatureId",
          "x-classification": "P0"
        },
        "modelVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "metric": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "value": {
          "$ref": "../common.schema.json#/$defs/Decimal",
          "x-classification": "P0"
        },
        "threshold": {
          "$ref": "../common.schema.json#/$defs/Decimal",
          "x-classification": "P0"
        },
        "window": {
          "$ref": "../common.schema.json#/$defs/TimeWindow",
          "x-classification": "P0"
        },
        "sampleSize": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "severity": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "breachId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        }
      }
    }
  }
}
