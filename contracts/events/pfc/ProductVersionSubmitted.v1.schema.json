{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pfc/ProductVersionSubmitted.v1.schema.json",
  "title": "ProductVersionSubmitted v1",
  "description": "Version moves Draft → Submitted",
  "x-event-type": "ProductVersionSubmitted",
  "x-registry-name": "pfc.ProductVersionSubmitted",
  "x-producer": "PFC",
  "x-topic": "pfc.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "product_id",
  "x-aggregate-type": [
    "Product"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "productId",
    "changeSetId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-02 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ProductVersionSubmitted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PFC"
    },
    "aggregateType": {
      "const": "Product"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "productId",
        "changeSetId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productCode",
        "version",
        "candidateArtefactHash",
        "changeClasses",
        "significantAdaptation",
        "requiredSignOffRoles",
        "changeSetId",
        "ratingSlotDeclaration"
      ],
      "properties": {
        "productCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "version": {
          "$ref": "../common.schema.json#/$defs/ProductVersionNumber",
          "x-classification": "P0"
        },
        "candidateArtefactHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "changeClasses": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        },
        "significantAdaptation": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "requiredSignOffRoles": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        },
        "changeSetId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "ratingSlotDeclaration": {
          "$ref": "../common.schema.json#/$defs/RatingSlotDeclaration",
          "description": "Rating-slot declaration carried by every ProductVersion* event (contract R-27, REQ-PFC-245)",
          "x-classification": "P0"
        }
      }
    }
  }
}
