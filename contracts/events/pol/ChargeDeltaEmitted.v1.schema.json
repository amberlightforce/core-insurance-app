{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/ChargeDeltaEmitted.v1.schema.json",
  "title": "ChargeDeltaEmitted v1",
  "description": "Every bound transaction. Set completeness fields set_id, set_size, index are required in the envelope (D4). Delta mode NET is final for P1-P2.",
  "x-event-type": "ChargeDeltaEmitted",
  "x-registry-name": "pol.ChargeDeltaEmitted",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "policy_id",
  "x-aggregate-type": [
    "Policy"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": true,
  "x-business-keys": [
    "policyId",
    "chargeId",
    "policyTermId",
    "transactionId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ChargeDeltaEmitted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "Policy"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "policyId",
        "chargeId",
        "policyTermId",
        "transactionId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "required": [
    "set_id",
    "set_size",
    "index"
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chargeId",
        "termId",
        "elementLocator",
        "coverageCode",
        "chargeType",
        "chargeCategory",
        "deltaKind",
        "netAmount",
        "validPeriod",
        "bookingDate",
        "transactionId",
        "correlationKey"
      ],
      "properties": {
        "chargeId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "termId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "elementLocator": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "coverageCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "chargeType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "chargeCategory": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "deltaKind": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "netAmount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "description": "Net amount and currency",
          "x-classification": "P0"
        },
        "validPeriod": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "bookingDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "transactionId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "correlationKey": {
          "$ref": "../common.schema.json#/$defs/Text",
          "description": "Business lineage key",
          "x-classification": "P0"
        },
        "taxTreatmentRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tax treatment reference (D2, TaxCalculator.treatment)",
          "x-classification": "P0"
        },
        "legalStatus": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Legal status of the tax or levy rate or treatment the line was priced with (MKT); always set on tax and levy lines of servicing transactions, absent for premium lines",
          "x-classification": "P0"
        },
        "provisional": {
          "type": "boolean",
          "description": "True when the line rests on a value that is not Settled (D-REG-02)",
          "x-classification": "P0"
        },
        "transactionKind": {
          "type": "string",
          "enum": [
            "NEW_BUSINESS",
            "ENDORSEMENT_DEBIT",
            "ENDORSEMENT_CREDIT",
            "CANCELLATION",
            "DISTANCE_WITHDRAWAL_VOID",
            "VOID",
            "RETURN_PREMIUM",
            "REINSTATEMENT",
            "FEE",
            "REFUND"
          ],
          "description": "Transaction kind of the bound transaction (the MKT TaxTransactionKind values, PRD-17 §7.5). Always set by POL from slice 3; BIL and FIN use it for the tax-treatment check (REQ-BIL-079, REQ-FIN-182). A renewal term is NEW_BUSINESS.",
          "x-classification": "P0"
        },
        "cancellationSource": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cancellation source (shared code list, REQ-POL-205). Always set when transactionKind is CANCELLATION or VOID, null otherwise.",
          "x-classification": "P0"
        },
        "treatmentRuleId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of the MKT treatment rule that decided a tax or levy line on a servicing transaction. Always set on such lines, null on premium lines.",
          "x-classification": "P0"
        },
        "treatmentRuleVersion": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Version of the treatment rule; always set with treatmentRuleId.",
          "x-classification": "P0"
        }
      }
    }
  }
}
