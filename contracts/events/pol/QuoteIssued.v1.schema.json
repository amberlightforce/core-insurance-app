{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/QuoteIssued.v1.schema.json",
  "title": "QuoteIssued v1",
  "description": "Quote version reaches Quoted",
  "x-event-type": "QuoteIssued",
  "x-registry-name": "pol.QuoteIssued",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "policy_id",
  "x-aggregate-type": [
    "Policy"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "policyId",
    "jobId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "QuoteIssued"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "Policy"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "policyId",
        "jobId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "jobType",
        "quoteVersion",
        "productCode",
        "productVersion",
        "premiumSummary",
        "validUntil",
        "referred"
      ],
      "properties": {
        "jobId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "jobType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "quoteVersion": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "productCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "productVersion": {
          "$ref": "../common.schema.json#/$defs/ProductVersionNumber",
          "x-classification": "P0"
        },
        "premiumSummary": {
          "$ref": "../common.schema.json#/$defs/PremiumSummary",
          "x-classification": "P0"
        },
        "validUntil": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "referred": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
