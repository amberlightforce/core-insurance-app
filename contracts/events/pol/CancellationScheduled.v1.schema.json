{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/CancellationScheduled.v1.schema.json",
  "title": "CancellationScheduled v1",
  "description": "Cancellation job Scheduled",
  "x-event-type": "CancellationScheduled",
