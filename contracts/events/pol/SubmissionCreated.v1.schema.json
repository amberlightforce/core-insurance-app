{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/SubmissionCreated.v1.schema.json",
  "title": "SubmissionCreated v1",
  "description": "Submission job created. Key is the job's provisional policy_id, which becomes the policy id at bind.",
  "x-event-type": "SubmissionCreated",
  "x-registry-name": "pol.SubmissionCreated",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "policy_id",
  "x-aggregate-type": [
    "Policy"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "policyId",
    "jobId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "SubmissionCreated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "Policy"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "policyId",
        "jobId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "accountId",
        "productCode",
        "productVersion",
        "channel"
      ],
      "properties": {
        "jobId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "accountId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "productCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "productVersion": {
          "$ref": "../common.schema.json#/$defs/ProductVersionNumber",
          "x-classification": "P0"
        },
        "channel": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "producerCode": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
