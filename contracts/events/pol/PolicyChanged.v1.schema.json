{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/PolicyChanged.v1.schema.json",
  "title": "PolicyChanged v1",
  "description": "Policy change, carry-forward, suspension or reactivation bound",
  "x-event-type": "PolicyChanged",
  "x-registry-name": "pol.PolicyChanged",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "policy_id",
  "x-aggregate-type": [
    "Policy"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PolicyChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "Policy"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionId",
        "kind",
        "effectiveDate",
        "changedElements",
        "vehicleCoverFacts",
        "priorTerm"
      ],
      "properties": {
        "transactionId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "CHANGE",
            "CARRY_FORWARD",
            "SUSPENSION",
            "REACTIVATION"
          ],
          "x-classification": "P0"
        },
        "effectiveDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "changedElements": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ChangedElement"
          },
          "x-classification": "P0"
        },
        "vehicleCoverFacts": {
          "$ref": "../common.schema.json#/$defs/VehicleCoverFacts",
          "x-classification": "P0"
        },
        "priorTerm": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
