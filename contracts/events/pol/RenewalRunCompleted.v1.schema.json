{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/RenewalRunCompleted.v1.schema.json",
  "title": "RenewalRunCompleted v1",
  "description": "Renewal run finished",
  "x-event-type": "RenewalRunCompleted",
  "x-registry-name": "pol.RenewalRunCompleted",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "legal_entity_id",
  "x-aggregate-type": [
    "LegalEntity"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RenewalRunCompleted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "LegalEntity"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "counts"
      ],
      "properties": {
        "runId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "counts": {
          "$ref": "../common.schema.json#/$defs/Counts",
          "x-classification": "P0"
        }
      }
    }
  }
}
