{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pol/QuoteExpired.v1.schema.json",
  "title": "QuoteExpired v1",
  "description": "Quote validity ends",
  "x-event-type": "QuoteExpired",
  "x-registry-name": "pol.QuoteExpired",
  "x-producer": "POL",
  "x-topic": "pol.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "policy_id",
  "x-aggregate-type": [
    "Policy"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-05 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "QuoteExpired"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "POL"
    },
    "aggregateType": {
      "const": "Policy"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "quoteVersion"
      ],
      "properties": {
        "jobId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "quoteVersion": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        }
      }
    }
  }
}
