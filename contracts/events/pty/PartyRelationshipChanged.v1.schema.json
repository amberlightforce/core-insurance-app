  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.2",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PartyRelationshipChanged"
    },
