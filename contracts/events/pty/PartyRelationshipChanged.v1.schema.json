{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/PartyRelationshipChanged.v1.schema.json",
  "title": "PartyRelationshipChanged v1",
  "description": "Relationship added or ended. Keyed on the from party_id.",
  "x-event-type": "PartyRelationshipChanged",
  "x-registry-name": "pty.PartyRelationshipChanged",
