{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/ExternalUserAccessChanged.v1.schema.json",
  "title": "ExternalUserAccessChanged v1",
  "description": "Grant or agency role change",
  "x-event-type": "ExternalUserAccessChanged",
  "x-registry-name": "pty.ExternalUserAccessChanged",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "intermediary_id",
  "x-aggregate-type": [
    "Intermediary"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "intermediaryId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.2",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ExternalUserAccessChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
