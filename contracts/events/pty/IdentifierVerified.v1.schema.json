{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/IdentifierVerified.v1.schema.json",
  "title": "IdentifierVerified v1",
  "description": "Verification status change. Identifier value is never carried.",
  "x-event-type": "IdentifierVerified",
  "x-registry-name": "pty.IdentifierVerified",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "party_id",
  "x-aggregate-type": [
    "Party"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "IdentifierVerified"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Party"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partyId",
        "scheme",
        "status",
        "source",
        "verifiedAt"
      ],
      "properties": {
        "partyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "scheme": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "source": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "verifiedAt": {
          "$ref": "../common.schema.json#/$defs/Instant",
          "x-classification": "P0"
        }
      }
    }
  }
}
