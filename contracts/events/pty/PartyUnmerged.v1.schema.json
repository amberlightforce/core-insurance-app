{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/PartyUnmerged.v1.schema.json",
  "title": "PartyUnmerged v1",
  "description": "Unmerge executed. Keyed on the survivor party_id of the merge being reversed (PRD-01 §8, XMR-F-117 applied).",
  "x-event-type": "PartyUnmerged",
  "x-registry-name": "pty.PartyUnmerged",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "party_id",
  "x-aggregate-type": [
    "Party"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PartyUnmerged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Party"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mergeId",
        "survivorPartyId",
        "restoredPartyIds",
        "reverseRepointMap"
      ],
      "properties": {
        "mergeId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "survivorPartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "restoredPartyIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P1",
          "x-personal-data": true
        },
        "reverseRepointMap": {
          "$ref": "../common.schema.json#/$defs/RepointMap",
          "description": "Per reference where the steward assigned post-merge changes",
          "x-classification": "P1",
          "x-personal-data": true
        }
      }
    }
  }
}
