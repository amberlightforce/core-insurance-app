{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/CommunicationPreferenceChanged.v1.schema.json",
  "title": "CommunicationPreferenceChanged v1",
  "description": "Preference change",
  "x-event-type": "CommunicationPreferenceChanged",
  "x-registry-name": "pty.CommunicationPreferenceChanged",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "party_id",
  "x-aggregate-type": [
    "Party"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "partyId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "CommunicationPreferenceChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Party"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "partyId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partyId",
        "purpose",
        "channel",
        "language",
        "medium"
      ],
      "properties": {
        "partyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "purpose": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "channel": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "language": {
          "$ref": "../common.schema.json#/$defs/LanguageCode",
          "x-classification": "P0"
        },
        "medium": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
