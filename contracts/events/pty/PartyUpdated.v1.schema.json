{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/PartyUpdated.v1.schema.json",
  "title": "PartyUpdated v1",
  "description": "Any attribute-group change or status transition",
  "x-event-type": "PartyUpdated",
  "x-registry-name": "pty.PartyUpdated",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "party_id",
  "x-aggregate-type": [
    "Party"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "partyId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PartyUpdated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Party"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "partyId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partyId",
        "partyNumber",
        "changedAttributeGroups",
        "backdated"
      ],
      "properties": {
        "partyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "partyNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "changedAttributeGroups": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "description": "Attribute groups changed (REQ-PTY-042)",
          "x-classification": "P0"
        },
        "newStatus": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "backdated": {
          "type": "boolean",
          "description": "R-04",
          "x-classification": "P0"
        },
        "effectiveFrom": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/LocalDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set for address and contact-point changes (R-04)",
          "x-classification": "P0"
        }
      }
    }
  }
}
