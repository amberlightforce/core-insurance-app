          "x-classification": "P0"
        },
        "newStatus": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "expiry": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/LocalDate"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
