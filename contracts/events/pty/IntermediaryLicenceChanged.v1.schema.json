    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Intermediary"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intermediaryId",
        "statusKind",
        "newStatus"
      ],
      "properties": {
        "intermediaryId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
