{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/IntermediaryLicenceChanged.v1.schema.json",
  "title": "IntermediaryLicenceChanged v1",
  "description": "Register, authorisation, licence, PI or CPD status change",
  "x-event-type": "IntermediaryLicenceChanged",
  "x-registry-name": "pty.IntermediaryLicenceChanged",
