{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/pty/ConsentChanged.v1.schema.json",
  "title": "ConsentChanged v1",
  "description": "Consent given, withdrawn, objection",
  "x-event-type": "ConsentChanged",
  "x-registry-name": "pty.ConsentChanged",
  "x-producer": "PTY",
  "x-topic": "pty.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "party_id",
  "x-aggregate-type": [
    "Party"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-01 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ConsentChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PTY"
    },
    "aggregateType": {
      "const": "Party"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partyId",
        "purpose",
        "channel",
        "kind",
        "newState",
        "proofRef"
      ],
      "properties": {
        "partyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "purpose": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "channel": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "GIVEN",
            "WITHDRAWN",
            "OBJECTION"
          ],
          "x-classification": "P0"
        },
        "newState": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "proofRef": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        }
      }
    }
  }
}
