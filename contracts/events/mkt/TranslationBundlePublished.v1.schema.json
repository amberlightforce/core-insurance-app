{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/mkt/TranslationBundlePublished.v1.schema.json",
  "title": "TranslationBundlePublished v1",
  "description": "A translation bundle version is published",
  "x-event-type": "TranslationBundlePublished",
  "x-registry-name": "mkt.TranslationBundlePublished",
  "x-producer": "MKT",
  "x-topic": "mkt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "stamp_id",
  "x-aggregate-type": [
    "Stamp"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "stampId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-17 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "TranslationBundlePublished"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "MKT"
    },
    "aggregateType": {
      "const": "Stamp"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "stampId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleVersion",
        "languages",
        "digest",
        "uiScopes"
      ],
      "properties": {
        "bundleVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "languages": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/LanguageCode"
          },
          "x-classification": "P0"
        },
        "digest": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "uiScopes": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
