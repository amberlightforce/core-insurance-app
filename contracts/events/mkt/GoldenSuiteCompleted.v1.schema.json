{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/mkt/GoldenSuiteCompleted.v1.schema.json",
  "title": "GoldenSuiteCompleted v1",
  "description": "A golden-suite run completes",
  "x-event-type": "GoldenSuiteCompleted",
  "x-registry-name": "mkt.GoldenSuiteCompleted",
  "x-producer": "MKT",
  "x-topic": "mkt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "pack_id",
  "x-aggregate-type": [
    "Pack"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "packId",
    "runId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-17 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "GoldenSuiteCompleted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "MKT"
    },
    "aggregateType": {
      "const": "Pack"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "packId",
        "runId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "mode",
        "packVersions",
        "passCount",
        "failCount",
        "unexpectedDivergences"
      ],
      "properties": {
        "runId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "mode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "packVersions": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          },
          "x-classification": "P0"
        },
        "passCount": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "failCount": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "unexpectedDivergences": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        }
      }
    }
  }
}
