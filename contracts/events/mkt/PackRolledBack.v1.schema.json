{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/mkt/PackRolledBack.v1.schema.json",
  "title": "PackRolledBack v1",
  "description": "A PackActivation of kind ROLLBACK reaches its instant",
  "x-event-type": "PackRolledBack",
  "x-registry-name": "mkt.PackRolledBack",
  "x-producer": "MKT",
  "x-topic": "mkt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "stamp_id",
  "x-aggregate-type": [
    "Stamp"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "stampId",
    "packId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-17 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PackRolledBack"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "MKT"
    },
    "aggregateType": {
      "const": "Stamp"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "stampId",
        "packId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packId",
        "fromVersion",
        "toVersion",
        "affectedWindow",
        "hashesInWindow",
        "reason",
        "pack",
        "legalEntity",
        "activationId",
        "window",
        "hashesIssued",
        "resultingHash"
      ],
      "properties": {
        "packId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "fromVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "toVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "affectedWindow": {
          "$ref": "../common.schema.json#/$defs/TimeWindow",
          "x-classification": "P0"
        },
        "hashesInWindow": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Sha256"
          },
          "x-classification": "P0"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Reason entered by the maker (20 to 128 characters). No personal data. Always set."
        },
        "pack": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Pack code (for example GR); the registry key of the pack. Always set (SL5-CONTRACTS-PACKS, D-SL5-08)."
        },
        "legalEntity": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Legal entity whose active pack version was rolled back. Always set."
        },
        "activationId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0",
          "description": "The PackActivation that produced this state. Always set."
        },
        "window": {
          "$ref": "../common.schema.json#/$defs/TimeWindow",
          "x-classification": "P0",
          "description": "Window during which the rolled-back version was the active one [from, to); equals affectedWindow. POL matches stored configuration hashes against hashesIssued (D-SL5-10). Always set."
        },
        "hashesIssued": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Sha256"
          },
          "x-classification": "P0",
          "description": "Configuration hashes issued while the rolled-back version was active; equals hashesInWindow. Always set (empty list when none)."
        },
        "resultingHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0",
          "description": "Configuration hash of the state recorded by the rollback (cause PACK_ROLLBACK, D-SL5-06). Always set."
        }
      }
    }
  }
}
