{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/mkt/RegimeCodeListPublished.v1.schema.json",
  "title": "RegimeCodeListPublished v1",
  "description": "A code list version is published or retired",
  "x-event-type": "RegimeCodeListPublished",
  "x-registry-name": "mkt.RegimeCodeListPublished",
  "x-producer": "MKT",
  "x-topic": "mkt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "pack_id",
  "x-aggregate-type": [
    "Pack"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "packId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-17 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RegimeCodeListPublished"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "MKT"
    },
    "aggregateType": {
      "const": "Pack"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "packId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regime",
        "taxonomyVersion",
        "effectiveDate",
        "retired"
      ],
      "properties": {
        "regime": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "taxonomyVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "effectiveDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "retired": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
