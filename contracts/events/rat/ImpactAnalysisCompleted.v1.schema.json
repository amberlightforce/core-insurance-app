{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/rat/ImpactAnalysisCompleted.v1.schema.json",
  "title": "ImpactAnalysisCompleted v1",
  "description": "Impact run completed. PRD-03 names population and metrics summary without their structure; both are open objects until RAT defines them.",
  "x-event-type": "ImpactAnalysisCompleted",
  "x-registry-name": "rat.ImpactAnalysisCompleted",
  "x-producer": "RAT",
  "x-topic": "rat.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "rating_slot_id",
  "x-aggregate-type": [
    "RatingSlot"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "minimal",
  "x-payload-note": "PRD-03 names population and metrics summary without their structure; both are open objects until RAT defines them.",
  "x-source": [
    "PRD-03 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ImpactAnalysisCompleted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RAT"
    },
    "aggregateType": {
      "const": "RatingSlot"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "candidateHash",
        "baselineHash",
        "population",
        "metricsSummary"
      ],
      "properties": {
        "runId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "candidateHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "baselineHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "population": {
          "$ref": "../common.schema.json#/$defs/OpenObject",
          "x-classification": "P0"
        },
        "metricsSummary": {
          "$ref": "../common.schema.json#/$defs/OpenObject",
          "x-classification": "P0"
        }
      }
    }
  }
}
