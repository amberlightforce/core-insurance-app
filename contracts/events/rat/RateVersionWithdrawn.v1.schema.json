{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/rat/RateVersionWithdrawn.v1.schema.json",
  "title": "RateVersionWithdrawn v1",
  "description": "Rollback",
  "x-event-type": "RateVersionWithdrawn",
  "x-registry-name": "rat.RateVersionWithdrawn",
  "x-producer": "RAT",
  "x-topic": "rat.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "rating_slot_id",
  "x-aggregate-type": [
    "RatingSlot"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-03 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RateVersionWithdrawn"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "RAT"
    },
    "aggregateType": {
      "const": "RatingSlot"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "withdrawnHash",
        "slots",
        "reason",
        "affectedQuoteCount",
        "affectedTransactionCount"
      ],
      "properties": {
        "withdrawnHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "reactivatedHash": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "affectedQuoteCount": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "affectedTransactionCount": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        }
      }
    }
  }
}
