{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/AiToggleChanged.v1.schema.json",
  "title": "AiToggleChanged v1",
  "description": "Toggle change; auto-disable on drift, bias or register status Suspended/Retired (REQ-PLT-354)",
  "x-event-type": "AiToggleChanged",
  "x-registry-name": "plt.AiToggleChanged",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "feature_id",
  "x-aggregate-type": [
    "AiFeature"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "featureId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "AiToggleChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "AiFeature"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "featureId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "featureId",
        "level",
        "newState",
        "actor",
        "reason"
      ],
      "properties": {
        "featureId": {
          "$ref": "../common.schema.json#/$defs/AiFeatureId",
          "x-classification": "P0"
        },
        "level": {
          "type": "string",
          "enum": [
            "TENANT",
            "LEGAL_ENTITY",
            "LINE_OF_BUSINESS",
            "ROLE",
            "USER"
          ],
          "x-classification": "P0"
        },
        "levelRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "newState": {
          "type": "string",
          "enum": [
            "ON",
            "OFF"
          ],
          "x-classification": "P0"
        },
        "actor": {
          "$ref": "../common.schema.json#/$defs/Actor",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "reason": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "E.g. REGISTER_STATUS (REQ-PLT-354)",
          "x-classification": "P0"
        }
      }
    }
  }
}
