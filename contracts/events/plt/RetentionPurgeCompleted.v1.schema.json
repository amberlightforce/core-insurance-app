{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/RetentionPurgeCompleted.v1.schema.json",
  "title": "RetentionPurgeCompleted v1",
  "description": "Retention engine run per RC code and module completes",
  "x-event-type": "RetentionPurgeCompleted",
  "x-registry-name": "plt.RetentionPurgeCompleted",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "rc_code",
  "x-aggregate-type": [
    "RetentionClass"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "rcCode"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RetentionPurgeCompleted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "RetentionClass"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "rcCode"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rcCode",
        "module",
        "counts"
      ],
      "properties": {
        "rcCode": {
          "$ref": "../common.schema.json#/$defs/RetentionClassCode",
          "x-classification": "P0"
        },
        "module": {
          "$ref": "../common.schema.json#/$defs/ModuleCode",
          "x-classification": "P0"
        },
        "counts": {
          "$ref": "../common.schema.json#/$defs/PurgeCounts",
          "x-classification": "P0"
        }
      }
    }
  }
}
