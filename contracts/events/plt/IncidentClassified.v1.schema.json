{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/IncidentClassified.v1.schema.json",
  "title": "IncidentClassified v1",
  "description": "Classification decided or changed",
  "x-event-type": "IncidentClassified",
  "x-registry-name": "plt.IncidentClassified",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "incident_id",
  "x-aggregate-type": [
    "Incident"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "IncidentClassified"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "Incident"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentClass",
        "criteriaMet",
        "timerDueDates"
      ],
      "properties": {
        "incidentClass": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "criteriaMet": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Code"
          },
          "x-classification": "P0"
        },
        "timerDueDates": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/TimerDue"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
