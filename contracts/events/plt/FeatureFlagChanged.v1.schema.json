{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/FeatureFlagChanged.v1.schema.json",
  "title": "FeatureFlagChanged v1",
  "description": "Flag state or targeting changes",
  "x-event-type": "FeatureFlagChanged",
  "x-registry-name": "plt.FeatureFlagChanged",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "flag_key",
  "x-aggregate-type": [
    "FeatureFlag"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "flagKey"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "FeatureFlagChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "FeatureFlag"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "flagKey"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flagKey",
        "environment",
        "oldState",
        "newState",
        "actor"
      ],
      "properties": {
        "flagKey": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "environment": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "oldState": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "newState": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "actor": {
          "$ref": "../common.schema.json#/$defs/Actor",
          "x-classification": "P1",
          "x-personal-data": true
        }
      }
    }
  }
}
