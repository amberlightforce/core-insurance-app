{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/ConfigChanged.v1.schema.json",
  "title": "ConfigChanged v1",
  "description": "Resolved value set of a context changes (activation, rollover). Keyed on resolution_context_id (PRD-14 applies XMR-F-117); PRD-18 table shows the context hash.",
  "x-event-type": "ConfigChanged",
  "x-registry-name": "plt.ConfigChanged",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "resolution_context_id",
  "x-aggregate-type": [
    "ResolutionContext"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ConfigChanged"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "ResolutionContext"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "layer",
        "newHash",
        "effectiveAt"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          },
          "x-classification": "P0"
        },
        "layer": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "oldHash": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Sha256"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "newHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "x-classification": "P0"
        },
        "effectiveAt": {
          "$ref": "../common.schema.json#/$defs/Instant",
          "x-classification": "P0"
        }
      }
    }
  }
}
