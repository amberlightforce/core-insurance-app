{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/ReferenceDataPublished.v1.schema.json",
  "title": "ReferenceDataPublished v1",
  "description": "Calendar version, FX rate set, currency change published",
  "x-event-type": "ReferenceDataPublished",
  "x-registry-name": "plt.ReferenceDataPublished",
