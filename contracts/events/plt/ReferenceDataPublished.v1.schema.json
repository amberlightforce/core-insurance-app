        "code",
        "version",
        "effectivePeriod"
      ],
      "properties": {
        "kind": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Calendar, FX rate set or currency",
          "x-classification": "P0"
        },
        "code": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "version": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "effectivePeriod": {
