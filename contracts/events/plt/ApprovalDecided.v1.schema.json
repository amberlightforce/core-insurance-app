{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/ApprovalDecided.v1.schema.json",
  "title": "ApprovalDecided v1",
  "description": "Approval decided, withdrawn or expired",
  "x-event-type": "ApprovalDecided",
  "x-registry-name": "plt.ApprovalDecided",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "request_id",
  "x-aggregate-type": [
    "ApprovalRequest"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "requestId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ApprovalDecided"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "ApprovalRequest"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "requestId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "decision",
        "decidedAt"
      ],
      "properties": {
        "requestId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "decision": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Decision, or withdrawn / expired",
          "x-classification": "P0"
        },
        "checkerUserId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P1",
          "x-personal-data": true
        },
        "decidedAt": {
          "$ref": "../common.schema.json#/$defs/Instant",
          "x-classification": "P0"
        },
        "approvalType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Approval type code (added by SL2-PLT, pre-release): lets the owning module pick its own decisions",
          "x-classification": "P0"
        },
        "objectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "description": "The subject decided (added by SL2-PLT, pre-release)",
          "x-classification": "P0"
        },
        "payloadHash": {
          "$ref": "../common.schema.json#/$defs/Sha256",
          "description": "Content hash the decision was made on (added by SL2-PLT, pre-release; REQ-PLT-117)",
          "x-classification": "P0"
        }
      }
    }
  }
}
