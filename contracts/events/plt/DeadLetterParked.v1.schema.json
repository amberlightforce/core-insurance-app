{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/plt/DeadLetterParked.v1.schema.json",
  "title": "DeadLetterParked v1",
  "description": "Message parked",
  "x-event-type": "DeadLetterParked",
  "x-registry-name": "plt.DeadLetterParked",
  "x-producer": "PLT",
  "x-topic": "plt.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "consumer_group",
  "x-aggregate-type": [
    "Consumer"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "consumerGroup"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-14 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "DeadLetterParked"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "PLT"
    },
    "aggregateType": {
      "const": "Consumer"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "consumerGroup"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventType",
        "consumer",
        "errorClass"
      ],
      "properties": {
        "eventType": {
          "$ref": "../common.schema.json#/$defs/EventTypeName",
          "x-classification": "P0"
        },
        "consumer": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "errorClass": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
