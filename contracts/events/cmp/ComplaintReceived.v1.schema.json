{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/cmp/ComplaintReceived.v1.schema.json",
  "title": "ComplaintReceived v1",
  "description": "Complaint transitions",
  "x-event-type": "ComplaintReceived",
  "x-registry-name": "cmp.ComplaintReceived",
  "x-producer": "CMP",
  "x-topic": "cmp.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "complaint_id",
  "x-aggregate-type": [
    "Complaint"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-11 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ComplaintReceived"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CMP"
    },
    "aggregateType": {
      "const": "Complaint"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complaintId",
        "links",
        "clockInstanceIds"
      ],
      "properties": {
        "complaintId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef"
          },
          "x-classification": "P0"
        },
        "clockInstanceIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        }
      }
    }
  }
}
