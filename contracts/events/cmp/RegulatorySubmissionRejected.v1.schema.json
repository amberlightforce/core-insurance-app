{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/cmp/RegulatorySubmissionRejected.v1.schema.json",
  "title": "RegulatorySubmissionRejected v1",
  "description": "Regulatory submission transitions. PRD-15 REQ-DAT-119 uses rejection reasons, but PRD-11 lists only type, period, receipt; reasons not yet specified.",
  "x-event-type": "RegulatorySubmissionRejected",
  "x-registry-name": "cmp.RegulatorySubmissionRejected",
  "x-producer": "CMP",
  "x-topic": "cmp.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "submission_id",
  "x-aggregate-type": [
    "RegulatorySubmission"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "submissionId"
  ],
  "x-payload-status": "minimal",
  "x-payload-note": "PRD-15 REQ-DAT-119 uses rejection reasons, but PRD-11 lists only type, period, receipt; reasons not yet specified.",
  "x-source": [
    "PRD-11 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RegulatorySubmissionRejected"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CMP"
    },
    "aggregateType": {
      "const": "RegulatorySubmission"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "submissionId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submissionId",
        "submissionType",
        "period"
      ],
      "properties": {
        "submissionId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "submissionType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "period": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "receipt": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
