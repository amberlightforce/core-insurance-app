{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/cmp/ComplaintClosed.v1.schema.json",
  "title": "ComplaintClosed v1",
  "description": "Complaint transitions. PRD-11 gives only the complaint reference for this transition.",
  "x-event-type": "ComplaintClosed",
  "x-registry-name": "cmp.ComplaintClosed",
  "x-producer": "CMP",
  "x-topic": "cmp.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "complaint_id",
  "x-aggregate-type": [
    "Complaint"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "minimal",
  "x-payload-note": "PRD-11 gives only the complaint reference for this transition.",
  "x-source": [
    "PRD-11 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ComplaintClosed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CMP"
    },
    "aggregateType": {
      "const": "Complaint"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complaintId"
      ],
      "properties": {
        "complaintId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        }
      }
    }
  }
}
