{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/FriendlySettlementSubmitted.v1.schema.json",
  "title": "FriendlySettlementSubmitted v1",
  "description": "FS case submitted to clearing",
  "x-event-type": "FriendlySettlementSubmitted",
  "x-registry-name": "clm.FriendlySettlementSubmitted",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "FriendlySettlementSubmitted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fsCaseId",
        "counterparty",
        "clearingValue"
      ],
      "properties": {
        "fsCaseId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "counterparty": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Counterparty insurer code",
          "x-classification": "P0"
        },
        "clearingValue": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        }
      }
    }
  }
}
