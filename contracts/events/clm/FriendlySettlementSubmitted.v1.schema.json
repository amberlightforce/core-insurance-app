{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/FriendlySettlementSubmitted.v1.schema.json",
  "title": "FriendlySettlementSubmitted v1",
  "description": "FS case submitted to clearing (D-SL4-02, D-SL4-03). The SPI result fields are always set by CLM.",
  "x-event-type": "FriendlySettlementSubmitted",
  "x-registry-name": "clm.FriendlySettlementSubmitted",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "claimId",
    "fsCaseId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "FriendlySettlementSubmitted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "claimId",
        "fsCaseId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fsCaseId",
        "counterparty",
        "clearingValue"
      ],
      "properties": {
        "fsCaseId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "counterparty": {
          "$ref": "../common.schema.json#/$defs/Code",
          "description": "Counterparty insurer code (company code from the pack member list, not a person)",
          "x-classification": "P0"
        },
        "clearingValue": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        },
        "claimId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Claim (the aggregate id); CLM always sets it",
          "x-classification": "P0"
        },
        "clearingReference": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clearing reference returned by IFriendlySettlementClearing.SubmitAsync; always set",
          "x-classification": "P0"
        },
        "clearingValueBasis": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Clearing value basis (ACTUAL or AVERAGE); ACTUAL in slice 4 (D-SL4-03). Always set",
          "x-classification": "P0"
        },
        "ruleId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Eligibility rule id that admitted the case; always set",
          "x-classification": "P0"
        },
        "ruleVersion": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Eligibility rule version; always set",
          "x-classification": "P0"
        },
        "legalStatus": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Legal status of the values used (UNVERIFIED for the stub, D-SL4-03); always set",
          "x-classification": "P0"
        },
        "provisional": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "True while the legal status is not Settled; always set",
          "x-classification": "P0"
        }
      }
    }
  }
}
