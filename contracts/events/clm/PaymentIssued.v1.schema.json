{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/PaymentIssued.v1.schema.json",
  "title": "PaymentIssued v1",
  "description": "DisbursementIssued received for a claim payment. Published when BIL's DisbursementIssued is received.",
  "x-event-type": "PaymentIssued",
  "x-registry-name": "clm.PaymentIssued",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentIssued"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paymentId",
        "transactionIds",
        "lines",
        "amount",
        "payeePartyId",
        "method",
        "disbursementId",
        "exGratia"
      ],
      "properties": {
        "paymentId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "transactionIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/OpenObject"
          },
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency3",
          "x-classification": "P0"
        },
        "payeePartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "method": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "disbursementId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "exGratia": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "complaintRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Redress payments (REQ-CLM-265)",
          "x-classification": "P0"
        }
      }
    }
  }
}
