{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/PaymentIssued.v1.schema.json",
  "title": "PaymentIssued v1",
  "description": "DisbursementIssued received for a claim payment. Published when BIL's DisbursementIssued is received.",
  "x-event-type": "PaymentIssued",
  "x-registry-name": "clm.PaymentIssued",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "claimId",
    "paymentId",
    "disbursementId|fsStatementId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentIssued"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "claimId",
        "paymentId"
      ],
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "disbursementId"
              ]
            },
            {
              "required": [
                "fsStatementId"
              ]
            }
          ]
        }
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paymentId",
        "transactionIds",
        "lines",
        "amount",
        "payeePartyId",
        "method",
        "disbursementId",
        "exGratia"
      ],
      "properties": {
        "claimId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Claim (the aggregate id, repeated so FIN and RI post from payload fields only, REQ-CLM-005); CLM always sets it",
          "x-classification": "P0"
        },
        "paymentId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "transactionIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ClaimPaymentLine"
          },
          "description": "Per reserve line paid: transaction id, reserve line, exposure, cost type and category, amount in three currencies, eroding flag",
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/MoneyByCurrency3",
          "x-classification": "P0"
        },
        "payeePartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "method": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0",
          "description": "Payment method (open Code), including CLEARING (Friendly Settlement at-fault leg, no cash movement by CLM)"
        },
        "disbursementId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "BIL disbursement. Always set unless method is CLEARING (D-SL4-02: the at-fault leg of a Friendly Settlement has no disbursement), then null and fsStatementId is set",
          "x-classification": "P0"
        },
        "exGratia": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "complaintRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "Redress payments (REQ-CLM-265)",
          "x-classification": "P0"
        },
        "accountingDate": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/LocalDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Accounting date of the payment transactions (PRD-07 §7.1 ClaimFinancialTransaction.accounting_date); FIN derives it from occurredAt in the entity zone when absent",
          "x-classification": "P0"
        },
        "fsStatementId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Friendly Settlement statement a CLEARING payment belongs to. Always set when method is CLEARING, null otherwise",
          "x-classification": "P0"
        }
      }
    }
  }
}
