{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/VendorInvoiceApproved.v1.schema.json",
  "title": "VendorInvoiceApproved v1",
  "description": "service accepted / invoice approved",
  "x-event-type": "VendorInvoiceApproved",
  "x-registry-name": "clm.VendorInvoiceApproved",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "VendorInvoiceApproved"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoiceId",
        "amount"
      ],
      "properties": {
        "invoiceId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "serviceId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "amount": {
          "$ref": "../common.schema.json#/$defs/Money",
          "x-classification": "P0"
        }
      }
    }
  }
}
