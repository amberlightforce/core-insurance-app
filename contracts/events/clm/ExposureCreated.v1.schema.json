{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/ExposureCreated.v1.schema.json",
  "title": "ExposureCreated v1",
  "description": "exposure created",
  "x-event-type": "ExposureCreated",
  "x-registry-name": "clm.ExposureCreated",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "claimId",
    "exposureId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ExposureCreated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "claimId",
        "exposureId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exposureId",
        "exposureNumber",
        "kind",
        "coverageCode",
        "claimantPartyId",
        "siiLob",
        "accidentDate"
      ],
      "properties": {
        "exposureId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "exposureNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "kind": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "coverageCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "claimantPartyId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "siiLob": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "accidentDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        }
      }
    }
  }
}
