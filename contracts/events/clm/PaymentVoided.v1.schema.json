{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/PaymentVoided.v1.schema.json",
  "title": "PaymentVoided v1",
  "description": "void, stop, return or disbursement rejection confirmed (D-SL4-13). Published once per payment correction, after the linked reversal transactions are posted.",
  "x-event-type": "PaymentVoided",
  "x-registry-name": "clm.PaymentVoided",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "claimId",
    "paymentId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentVoided"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "claimId",
        "paymentId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paymentId",
        "reversalTransactionIds",
        "reason"
      ],
      "properties": {
        "paymentId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "reversalTransactionIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "reason": {
          "type": "string",
          "enum": [
            "VOIDED",
            "STOPPED",
            "RETURNED",
            "REJECTED"
          ],
          "x-classification": "P0",
          "description": "VOIDED = void before clearing; STOPPED = stopped at release; RETURNED = bank return; REJECTED = disbursement rejected"
        },
        "claimId": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "Claim (the aggregate id, repeated so FIN posts from payload fields only); CLM always sets it",
          "x-classification": "P0"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ClaimPaymentLine"
          },
          "description": "The reversed payment lines, one per reserve line, with the positive amount reversed (three currencies), the reserve line, exposure, cost type and category and the eroding flag. CLM always sets them; lineKey = the reversal transaction id (one of reversalTransactionIds). FIN posts the reversal from these lines.",
          "x-classification": "P0"
        },
        "amount": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/MoneyByCurrency3"
            },
            {
              "type": "null"
            }
          ],
          "description": "Total reversed amount; CLM always sets it",
          "x-classification": "P0"
        },
        "method": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Method of the payment that was corrected (CLEARING payments have no disbursement and are voided only through their statement)",
          "x-classification": "P0"
        }
      }
    }
  }
}
