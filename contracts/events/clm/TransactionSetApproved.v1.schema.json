    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "TransactionSetApproved"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setId",
        "transactionIds",
        "totalsByKind",
        "approverUserIds",
        "authorityCheckIds",
        "fourEyes"
      ],
      "properties": {
        "setId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "transactionIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "totalsByKind": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/KindTotal"
          },
          "x-classification": "P0"
        },
        "approverUserIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P1",
          "x-personal-data": true
        },
        "authorityCheckIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Uuid"
          },
          "x-classification": "P0"
        },
        "fourEyes": {
          "type": "boolean",
          "x-classification": "P0"
        }
      }
    }
  }
}
