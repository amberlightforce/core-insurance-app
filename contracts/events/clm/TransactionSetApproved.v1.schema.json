{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/TransactionSetApproved.v1.schema.json",
  "title": "TransactionSetApproved v1",
  "description": "set approved",
  "x-event-type": "TransactionSetApproved",
  "x-registry-name": "clm.TransactionSetApproved",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
