{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/SiuCaseOpened.v1.schema.json",
  "title": "SiuCaseOpened v1",
  "description": "SIU case lifecycle. Restricted contract; no narrative. Keyed on the first linked claim.",
  "x-event-type": "SiuCaseOpened",
  "x-registry-name": "clm.SiuCaseOpened",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P2",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "SiuCaseOpened"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P2"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId"
      ],
      "properties": {
        "caseId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P2",
          "x-personal-data": true
        }
      }
    }
  }
}
