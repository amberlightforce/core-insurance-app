{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/clm/CoverageVerified.v1.schema.json",
  "title": "CoverageVerified v1",
  "description": "first verification and each completed re-verification",
  "x-event-type": "CoverageVerified",
  "x-registry-name": "clm.CoverageVerified",
  "x-producer": "CLM",
  "x-topic": "clm.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "claim_id",
  "x-aggregate-type": [
    "Claim"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "claimId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-07 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "CoverageVerified"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CLM"
    },
    "aggregateType": {
      "const": "Claim"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "claimId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotRef",
        "outcome",
        "decisionMaker"
      ],
      "properties": {
        "snapshotRef": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        },
        "outcome": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "decisionMaker": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P1",
          "x-personal-data": true
        }
      }
    }
  }
}
