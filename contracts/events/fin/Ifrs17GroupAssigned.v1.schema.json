{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/fin/Ifrs17GroupAssigned.v1.schema.json",
  "title": "Ifrs17GroupAssigned v1",
