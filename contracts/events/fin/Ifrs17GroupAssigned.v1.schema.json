        "groupCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "portfolio": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "cohort": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "profitabilityGroup": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "model": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "recognitionDate": {
          "$ref": "../common.schema.json#/$defs/LocalDate",
          "x-classification": "P0"
        },
        "version": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        }
