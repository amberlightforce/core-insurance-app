      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "FIN"
    },
    "aggregateType": {
      "const": "Ifrs17AssignmentSubject"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
