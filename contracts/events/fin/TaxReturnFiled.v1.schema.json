{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/fin/TaxReturnFiled.v1.schema.json",
  "title": "TaxReturnFiled v1",
  "description": "Tax or levy return Filed",
  "x-event-type": "TaxReturnFiled",
  "x-registry-name": "fin.TaxReturnFiled",
  "x-producer": "FIN",
  "x-topic": "fin.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "legal_entity_id",
  "x-aggregate-type": [
    "LegalEntity"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-09 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "TaxReturnFiled"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "FIN"
    },
    "aggregateType": {
      "const": "LegalEntity"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "returnId",
        "taxCode",
        "period",
        "totals",
        "filingReference"
      ],
      "properties": {
        "returnId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P0"
        },
        "taxCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "period": {
          "$ref": "../common.schema.json#/$defs/DatePeriod",
          "x-classification": "P0"
        },
        "totals": {
          "$ref": "../common.schema.json#/$defs/OpenObject",
          "x-classification": "P0"
        },
        "filingReference": {
          "$ref": "../common.schema.json#/$defs/Text",
          "x-classification": "P0"
        }
      }
    }
  }
}
