{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/wrk/ActivityCompleted.v1.schema.json",
  "title": "ActivityCompleted v1",
  "description": "Completed",
  "x-event-type": "ActivityCompleted",
  "x-registry-name": "wrk.ActivityCompleted",
  "x-producer": "WRK",
  "x-topic": "wrk.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "activity_id",
  "x-aggregate-type": [
    "Activity"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-business-keys": [
    "activityId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-13 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ActivityCompleted"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "WRK"
    },
    "aggregateType": {
      "const": "Activity"
    },
    "dataClassification": {
      "const": "P1"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "activityId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomeCode",
        "closedAt",
        "closedBy",
        "primaryObjectRef",
        "patternCode",
        "elapsedMinutes",
        "slaStatus"
      ],
      "properties": {
        "outcomeCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "closedAt": {
          "$ref": "../common.schema.json#/$defs/Instant",
          "x-classification": "P0"
        },
        "closedBy": {
          "$ref": "../common.schema.json#/$defs/Actor",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "primaryObjectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-classification": "P0"
        },
        "patternCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "elapsedMinutes": {
          "$ref": "../common.schema.json#/$defs/NonNegativeInt",
          "x-classification": "P0"
        },
        "slaStatus": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        }
      }
    }
  }
}
