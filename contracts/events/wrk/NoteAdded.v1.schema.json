{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/wrk/NoteAdded.v1.schema.json",
  "title": "NoteAdded v1",
  "description": "Note created. Note text is never carried.",
  "x-event-type": "NoteAdded",
  "x-registry-name": "wrk.NoteAdded",
  "x-producer": "WRK",
  "x-topic": "wrk.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "note_id",
  "x-aggregate-type": [
    "Note"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-13 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "NoteAdded"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "WRK"
    },
    "aggregateType": {
      "const": "Note"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primaryObjectRef",
        "topic",
        "confidentiality",
        "authorUserId",
        "language"
      ],
      "properties": {
        "primaryObjectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-classification": "P0"
        },
        "topic": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "confidentiality": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "authorUserId": {
          "$ref": "../common.schema.json#/$defs/Uuid",
          "x-classification": "P1",
          "x-personal-data": true
        },
        "language": {
          "$ref": "../common.schema.json#/$defs/LanguageCode",
          "x-classification": "P0"
        }
      }
    }
  }
}
