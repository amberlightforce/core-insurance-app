{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/wrk/ActivityCreated.v1.schema.json",
  "title": "ActivityCreated v1",
  "description": "Activity created",
  "x-event-type": "ActivityCreated",
  "x-registry-name": "wrk.ActivityCreated",
  "x-producer": "WRK",
  "x-topic": "wrk.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "activity_id",
  "x-aggregate-type": [
    "Activity"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-13 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ActivityCreated"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "WRK"
    },
    "aggregateType": {
      "const": "Activity"
    },
    "dataClassification": {
      "const": "P0"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityNumber",
        "patternCode",
        "patternVersion",
        "category",
        "primaryObjectRef",
        "secondaryRefs",
        "priority",
        "createdByModule",
        "mandatory",
        "gateBlocking"
      ],
      "properties": {
        "activityNumber": {
          "$ref": "../common.schema.json#/$defs/BusinessNumber",
          "x-classification": "P0"
        },
        "patternCode": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "patternVersion": {
          "$ref": "../common.schema.json#/$defs/VersionLabel",
          "x-classification": "P0"
        },
        "category": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "primaryObjectRef": {
          "$ref": "../common.schema.json#/$defs/ObjectRef",
          "x-classification": "P0"
        },
        "secondaryRefs": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/ObjectRef"
          },
          "x-classification": "P0"
        },
        "priority": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "targetAt": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "escalationAt": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Instant"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "createdByModule": {
          "$ref": "../common.schema.json#/$defs/ModuleCode",
          "x-classification": "P0"
        },
        "causeRef": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        },
        "mandatory": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "gateBlocking": {
          "type": "boolean",
          "x-classification": "P0"
        },
        "sequence": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/NonNegativeInt"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
