{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/wrk/RequestClosed.v1.schema.json",
  "title": "RequestClosed v1",
  "description": "Closed, withdrawn or rejected",
  "x-event-type": "RequestClosed",
  "x-registry-name": "wrk.RequestClosed",
  "x-producer": "WRK",
  "x-topic": "wrk.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "request_id",
  "x-aggregate-type": [
    "Request"
  ],
  "x-data-classification": "P0",
  "x-set-completeness": false,
  "x-business-keys": [
    "requestId"
  ],
  "x-payload-status": "full",
  "x-source": [
    "PRD-13 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "RequestClosed"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "WRK"
    },
    "aggregateType": {
      "const": "Request"
    },
    "dataClassification": {
      "const": "P0"
    },
    "businessKeys": {
      "type": "object",
      "description": "Lineage keys this event must carry (D5, D-CON-01, D-CON-28). 'a|b' in x-business-keys means at least one of them.",
      "required": [
        "requestId"
      ]
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finalStatus"
      ],
      "properties": {
        "finalStatus": {
          "type": "string",
          "enum": [
            "CLOSED",
            "WITHDRAWN",
            "REJECTED"
          ],
          "x-classification": "P0"
        },
        "reason": {
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/Code"
            },
            {
              "type": "null"
            }
          ],
          "x-classification": "P0"
        }
      }
    }
  }
}
