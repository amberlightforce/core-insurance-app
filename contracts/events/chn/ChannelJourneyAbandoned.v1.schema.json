{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.coreinsurance.example/events/chn/ChannelJourneyAbandoned.v1.schema.json",
  "title": "ChannelJourneyAbandoned v1",
  "description": "Journey inactive beyond threshold before command",
  "x-event-type": "ChannelJourneyAbandoned",
  "x-registry-name": "chn.ChannelJourneyAbandoned",
  "x-producer": "CHN",
  "x-topic": "chn.events.v1",
  "x-schema-version": "1.0",
  "x-ordering-key": "session_id",
  "x-aggregate-type": [
    "ChannelSession"
  ],
  "x-data-classification": "P1",
  "x-set-completeness": false,
  "x-payload-status": "full",
  "x-source": [
    "PRD-12 §8.1",
    "PRD-18 §8.2"
  ],
  "allOf": [
    {
      "$ref": "../envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "ChannelJourneyAbandoned"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+$"
    },
    "producer": {
      "const": "CHN"
    },
    "aggregateType": {
      "const": "ChannelSession"
    },
    "dataClassification": {
      "const": "P1"
    },
    "payload": {
      "$ref": "#/$defs/Payload"
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "journeyType",
        "lastStep",
        "pseudonymousIds"
      ],
      "properties": {
        "journeyType": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "lastStep": {
          "$ref": "../common.schema.json#/$defs/Code",
          "x-classification": "P0"
        },
        "pseudonymousIds": {
          "type": "array",
          "items": {
            "$ref": "../common.schema.json#/$defs/Text"
          },
          "x-classification": "P1",
          "x-personal-data": true
        }
      }
    }
  }
}
